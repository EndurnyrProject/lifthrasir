// Marionette Control (CG_MARIONETTE) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive. Angles are raw STR units (1024 per turn).
//
// Shape: the caster's power strung to the target -- a violet puppet's threads
// drop from above and snap taut on the target's shoulders, a soft link glow
// blooms at the torso, then the threads lift away. Supportive and calm, not a
// hit burst; distinct from Blade Stop's white inward seize. The persistent
// stat link itself is server-owned, this is only the cast signature (~26f).
(
    fps: 30,
    layers: [
        // Left puppet thread dropping onto the shoulder.
        (
            textures: ["ro://data/texture/effect/alpha_center.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (296.0, 120.0), quad: (6.0, 6.0),   color: (200, 170, 255, 0),   angle: 0.0 ),
                ( at: 5,  offset: (296.0, 175.0), quad: (8.0, 90.0),  color: (215, 185, 255, 220), angle: 0.0 ),
                ( at: 9,  offset: (298.0, 205.0), quad: (7.0, 70.0),  color: (225, 200, 255, 240), angle: 0.0 ),
                ( at: 20, offset: (298.0, 210.0), quad: (5.0, 55.0),  color: (205, 180, 255, 90),  angle: 0.0 ),
                ( at: 26, offset: (298.0, 205.0), quad: (4.0, 40.0),  color: (195, 165, 250, 0),   angle: 0.0 ),
            ],
        ),
        // Right puppet thread, a beat later.
        (
            textures: ["ro://data/texture/effect/alpha_center.tga"],
            blend: Add,
            keys: [
                ( at: 2,  offset: (342.0, 120.0), quad: (6.0, 6.0),   color: (200, 170, 255, 0),   angle: 0.0 ),
                ( at: 7,  offset: (342.0, 175.0), quad: (8.0, 90.0),  color: (215, 185, 255, 220), angle: 0.0 ),
                ( at: 11, offset: (340.0, 205.0), quad: (7.0, 70.0),  color: (225, 200, 255, 240), angle: 0.0 ),
                ( at: 22, offset: (340.0, 210.0), quad: (5.0, 55.0),  color: (205, 180, 255, 90),  angle: 0.0 ),
                ( at: 28, offset: (340.0, 205.0), quad: (4.0, 40.0),  color: (195, 165, 250, 0),   angle: 0.0 ),
            ],
        ),
        // Central thread down the spine.
        (
            textures: ["ro://data/texture/effect/alpha_center.tga"],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 110.0), quad: (6.0, 6.0),   color: (210, 185, 255, 0),   angle: 0.0 ),
                ( at: 6,  offset: (319.0, 170.0), quad: (8.0, 110.0), color: (225, 200, 255, 200), angle: 0.0 ),
                ( at: 12, offset: (319.0, 200.0), quad: (7.0, 80.0),  color: (235, 215, 255, 220), angle: 0.0 ),
                ( at: 24, offset: (319.0, 205.0), quad: (5.0, 60.0),  color: (210, 185, 255, 80),  angle: 0.0 ),
                ( at: 30, offset: (319.0, 200.0), quad: (4.0, 45.0),  color: (195, 165, 250, 0),   angle: 0.0 ),
            ],
        ),
        // Soft violet link glow blooming at the torso.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 238.0), quad: (20.0, 20.0),   color: (180, 150, 255, 0) ),
                ( at: 11, offset: (319.0, 238.0), quad: (110.0, 110.0), color: (200, 175, 255, 210) ),
                ( at: 20, offset: (319.0, 238.0), quad: (130.0, 130.0), color: (185, 155, 255, 130) ),
                ( at: 30, offset: (319.0, 238.0), quad: (150.0, 150.0), color: (170, 140, 250, 0) ),
            ],
        ),
        // Thin marionette control ring tightening around the torso.
        (
            textures: ["ro://data/texture/effect/ring_b.bmp"],
            blend: Add,
            keys: [
                ( at: 8,  offset: (319.0, 240.0), quad: (150.0, 90.0), color: (200, 175, 255, 0) ),
                ( at: 13, offset: (319.0, 240.0), quad: (110.0, 66.0), color: (215, 190, 255, 200) ),
                ( at: 22, offset: (319.0, 240.0), quad: (80.0, 48.0),  color: (205, 180, 255, 110) ),
                ( at: 30, offset: (319.0, 240.0), quad: (60.0, 36.0),  color: (190, 160, 250, 0) ),
            ],
        ),
    ],
)
