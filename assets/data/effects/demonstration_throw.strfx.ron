                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 12, offset: (337.0, 286.0), quad: (24.0, 30.0), color: (255, 170, 80, 0),   texture_index: 2 ),
                ( at: 15, offset: (339.0, 262.0), quad: (42.0, 76.0), color: (255, 190, 100, 235), texture_index: 3 ),
                ( at: 19, offset: (338.0, 258.0), quad: (44.0, 80.0), color: (255, 180, 90, 220), texture_index: 0 ),
                ( at: 23, offset: (337.0, 262.0), quad: (40.0, 72.0), color: (255, 170, 80, 180), texture_index: 1 ),
                ( at: 31, offset: (336.0, 272.0), quad: (34.0, 56.0), color: (255, 150, 70, 0),   texture_index: 2 ),
            ],
        ),
        // Embers thrown up and out, falling back.
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 11, offset: (314.0, 272.0), quad: (14.0, 14.0), color: (255, 210, 130, 255) ),
                ( at: 16, offset: (280.0, 226.0), quad: (16.0, 16.0), color: (255, 190, 110, 230) ),
