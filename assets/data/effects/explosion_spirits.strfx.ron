// Fury / Explosion Spirits (MO_EXPLOSIONSPIRITS) - authored STR-style effect.
//
// Convention (see fire_bolt.strfx.ron / systems.rs): offset & quad in STR pixels,
// anchor at (319, 291) on the caster, STR_WORLD_SCALE 0.2, smaller offset.y =
// higher; fps 30, linear key lerp, Add = additive.
//
// One pop of the native 폭기.tga starburst emblem on the chest, in and out.
// The persistent red ki aura for the duration lives in `efsts:` (EFST 86 ->
// kiaura1.str). ~14f.
(
    fps: 30,
    layers: [
        (
            textures: ["ro://data/texture/effect/폭기.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 245.0), quad: (50.0, 50.0),   color: (255, 255, 255, 0) ),
                ( at: 4,  offset: (319.0, 245.0), quad: (150.0, 150.0), color: (255, 255, 255, 255) ),
                ( at: 8,  offset: (319.0, 245.0), quad: (170.0, 170.0), color: (255, 255, 255, 255) ),
                ( at: 14, offset: (319.0, 245.0), quad: (200.0, 200.0), color: (255, 245, 230, 0) ),
            ],
        ),
    ],
)
