// Chemical Protection (AM_CP_WEAPON / _SHIELD / _ARMOR / _HELM) -- authored
// effect, approximation, shared by all four pieces.
//
// No reference artwork: roBrowserLegacy's `SkillEffect.js` has no AM_CP_* entry.
// Aesir's `ChemicalProtection.cast/6` applies the coating status to a player
// target and reports the recipient, so this plays on the coated character; the
// four skills differ only in which piece is protected, and the descriptor
// cannot tell them apart, so one neutral coating is shared instead of inventing
// four different looks. A refused cast (the target does not wear the piece)
// produces no effect packet at all.
//
// Convention: (319, 291) is the anchor (the recipient's feet), a smaller
// offset.y renders higher. fps 30, keys lerp. All layers are additive.
//
// Shape: the Coating Bottle is poured over the target -- two white bands sweep
// from the feet and from above the head and close over the body, then a soft
// sheen holds for a beat and fades. A vertical sweep reads as "this body is
// sealed", which no other pre-renewal buff burst in the catalog does, and it
// stays distinct from the party-buff glows.
(
    fps: 30,
    layers: [
        // Band sweeping up from the feet.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 293.0), quad: (170.0, 85.0), color: (225, 255, 250, 0) ),
                ( at: 3,  offset: (319.0, 289.0), quad: (150.0, 75.0), color: (235, 255, 250, 210) ),
                ( at: 12, offset: (319.0, 258.0), quad: (110.0, 55.0), color: (225, 255, 250, 150) ),
                ( at: 20, offset: (319.0, 236.0), quad: (70.0, 35.0),  color: (215, 250, 245, 0) ),
            ],
        ),
        // Band closing down from above the head.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 196.0), quad: (150.0, 75.0), color: (215, 255, 245, 0) ),
                ( at: 4,  offset: (319.0, 202.0), quad: (140.0, 70.0), color: (230, 255, 248, 200) ),
                ( at: 13, offset: (319.0, 234.0), quad: (100.0, 50.0), color: (220, 250, 242, 140) ),
                ( at: 21, offset: (319.0, 256.0), quad: (64.0, 32.0),  color: (210, 245, 238, 0) ),
            ],
        ),
        // Sheen over the coated body.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 2,  offset: (319.0, 250.0), quad: (60.0, 60.0),   color: (230, 255, 250, 0) ),
                ( at: 8,  offset: (319.0, 250.0), quad: (140.0, 140.0), color: (240, 255, 252, 170) ),
                ( at: 16, offset: (319.0, 250.0), quad: (160.0, 160.0), color: (225, 250, 246, 95) ),
                ( at: 26, offset: (319.0, 250.0), quad: (180.0, 180.0), color: (210, 240, 236, 0) ),
            ],
        ),
        // Glints where the coat sets.
        (
            textures: ["ro://data/texture/effect/pika02.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (305.0, 262.0), quad: (14.0, 14.0), color: (235, 255, 250, 0),   angle: 0.0 ),
                ( at: 9,  offset: (305.0, 262.0), quad: (30.0, 30.0), color: (245, 255, 252, 235), angle: 40.0 ),
                ( at: 15, offset: (305.0, 262.0), quad: (22.0, 22.0), color: (225, 250, 246, 0),   angle: 80.0 ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pika02.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (336.0, 240.0), quad: (12.0, 12.0), color: (235, 255, 250, 0),   angle: 0.0 ),
                ( at: 13, offset: (336.0, 240.0), quad: (26.0, 26.0), color: (245, 255, 252, 235), angle: -40.0 ),
                ( at: 19, offset: (336.0, 240.0), quad: (18.0, 18.0), color: (225, 250, 246, 0),   angle: -80.0 ),
            ],
        ),
    ],
)
