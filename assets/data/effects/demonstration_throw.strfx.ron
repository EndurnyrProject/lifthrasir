// Demonstration (AM_DEMONSTRATION) -- authored effect, approximation.
//
// The reference client has no cast/impact effect for AM_DEMONSTRATION: its only
// visual is the burning field, EF_DEMONSTRATION (302), the retail
// `이팩트/데몬스트레이션` SPR/ACT that `skill_units[229]` plays. This one-shot covers
// the Fire Bottle landing on the cell and hands over to that field.
//
// Convention (see heavens_drive.strfx.ron / fire_bolt.strfx.ron): offset & quad
// are STR pixels, the runtime maps (offset - (319, 291)) * 0.2 into world space,
// so (319, 291) sits on the anchor (here the targeted ground cell). y grows
// DOWN, so a smaller offset.y renders higher. fps 30, keys lerp linearly and
// texture_index is held (flipbook). Angle is raw STR units, 1024 per turn.
//
// Shape: the Fire Bottle item icon spins down onto the cell with a lit wick,
// shatters in a hot flash and a fire cloud, throws two flame tongues and
// embers, and leaves a low ground glow under rising smoke. Avoid `lens_*`,
// `ring_*` and `water_slplash` here: they are cylinder strips and render as
// bars on a flat quad.
(
    fps: 30,
    layers: [
        // The Fire Bottle, magenta-keyed item icon, spinning as it falls.
        (
            textures: ["ro://data/texture/유저인터페이스/item/화염병.bmp"],
            blend: Blend,
            keys: [
                ( at: 0,  offset: (279.0, 150.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: 0.0 ),
                ( at: 2,  offset: (288.0, 178.0), quad: (26.0, 26.0), color: (255, 255, 255, 255), angle: 220.0 ),
                ( at: 6,  offset: (305.0, 232.0), quad: (26.0, 26.0), color: (255, 255, 255, 255), angle: 660.0 ),
                ( at: 9,  offset: (316.0, 270.0), quad: (26.0, 26.0), color: (255, 255, 255, 255), angle: 990.0 ),
                ( at: 10, offset: (319.0, 282.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: 1100.0 ),
            ],
        ),
        // The lit wick trailing the bottle.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 0,  offset: (277.0, 138.0), quad: (14.0, 22.0), color: (255, 170, 80, 0),   texture_index: 0 ),
                ( at: 2,  offset: (286.0, 166.0), quad: (16.0, 26.0), color: (255, 180, 90, 230), texture_index: 1 ),
                ( at: 4,  offset: (295.0, 192.0), quad: (16.0, 26.0), color: (255, 180, 90, 230), texture_index: 2 ),
                ( at: 6,  offset: (304.0, 220.0), quad: (16.0, 26.0), color: (255, 180, 90, 230), texture_index: 3 ),
                ( at: 9,  offset: (315.0, 258.0), quad: (16.0, 26.0), color: (255, 180, 90, 230), texture_index: 0 ),
                ( at: 10, offset: (319.0, 272.0), quad: (14.0, 22.0), color: (255, 170, 80, 0),   texture_index: 1 ),
            ],
        ),
        // Shatter flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 9,  offset: (319.0, 276.0), quad: (20.0, 20.0),   color: (255, 200, 120, 0) ),
                ( at: 11, offset: (319.0, 276.0), quad: (130.0, 130.0), color: (255, 210, 140, 240) ),
                ( at: 16, offset: (319.0, 276.0), quad: (160.0, 160.0), color: (255, 150, 70, 90) ),
                ( at: 24, offset: (319.0, 276.0), quad: (175.0, 175.0), color: (220, 100, 40, 0) ),
            ],
        ),
        // Fire cloud bursting off the splash.
        (
            textures: ["ro://data/texture/effect/fire_smoke_a.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (319.0, 276.0), quad: (40.0, 40.0),   color: (255, 200, 140, 0) ),
                ( at: 13, offset: (319.0, 268.0), quad: (100.0, 100.0), color: (255, 210, 150, 200) ),
                ( at: 22, offset: (319.0, 254.0), quad: (125.0, 125.0), color: (255, 170, 110, 90) ),
                ( at: 34, offset: (319.0, 240.0), quad: (140.0, 140.0), color: (200, 110, 60, 0) ),
            ],
        ),
        // Two flame tongues licking up, settling into the field sprite.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 11, offset: (302.0, 286.0), quad: (24.0, 30.0), color: (255, 170, 80, 0),   texture_index: 0 ),
                ( at: 14, offset: (300.0, 264.0), quad: (40.0, 72.0), color: (255, 190, 100, 235), texture_index: 1 ),
                ( at: 18, offset: (301.0, 260.0), quad: (42.0, 78.0), color: (255, 180, 90, 220), texture_index: 2 ),
                ( at: 22, offset: (302.0, 264.0), quad: (40.0, 70.0), color: (255, 170, 80, 180), texture_index: 3 ),
                ( at: 30, offset: (303.0, 272.0), quad: (34.0, 56.0), color: (255, 150, 70, 0),   texture_index: 0 ),
