                ( at: 8,  offset: (312.0, 236.0), quad: (16.0, 16.0), color: (200, 255, 170, 255) ),
                ( at: 14, offset: (268.0, 204.0), quad: (18.0, 18.0), color: (190, 255, 160, 230) ),
                ( at: 23, offset: (250.0, 270.0), quad: (10.0, 10.0), color: (130, 220, 110, 0) ),
