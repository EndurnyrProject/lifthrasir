// Flasher (HT_FLASHER) - authored effect.
//
// Shape: one brief blinding white bloom at the trap, then it clears before it
// reads as an explosion. Retail EF_FLASHER is a hardcoded client flash with no
// STR. Soft round glow11 only: the lens_* strips are cylinder bands and draw as
// hard boxes on a billboard. The bloom sits above the feet so the ground plane
// does not cut it in half; a flat glow lights the ground under it.
(
    fps: 30,
    layers: [
        // Blinding white bloom.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 250.0), quad: (30.0, 30.0),   color: (255, 255, 255, 0) ),
                ( at: 2, offset: (319.0, 250.0), quad: (230.0, 230.0), color: (255, 255, 255, 255) ),
                ( at: 9, offset: (319.0, 250.0), quad: (300.0, 300.0), color: (235, 245, 255, 0) ),
            ],
        ),
        // Hot core, gone before the bloom.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 262.0), quad: (20.0, 20.0),   color: (255, 255, 255, 0) ),
                ( at: 1, offset: (319.0, 262.0), quad: (110.0, 110.0), color: (255, 255, 255, 255) ),
                ( at: 5, offset: (319.0, 262.0), quad: (130.0, 130.0), color: (255, 255, 255, 0) ),
            ],
        ),
        // Flat flash on the ground around the trap.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 287.0), quad: (40.0, 12.0),  color: (255, 255, 255, 0) ),
                ( at: 2, offset: (319.0, 287.0), quad: (260.0, 78.0), color: (255, 255, 255, 220) ),
                ( at: 9, offset: (319.0, 287.0), quad: (320.0, 96.0), color: (235, 245, 255, 0) ),
            ],
        ),
    ],
)
