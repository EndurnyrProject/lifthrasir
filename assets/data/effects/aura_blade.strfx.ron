// Aura Blade (LK_AURABLADE): the reference EF_AURABLADE plays the sound over a
// small double white aura on the caster. Here two white aura pulses, pale
// blue-white rays, and a blade of light (a tall streak with a short crossguard)
// rising out of the body to stand over the head, with glints at its tips.
// Effect layers share the character's plane, so nothing load-bearing sits
// behind the body.
// A cast burst, not the duration aura. ~0.8s.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the caster's feet, smaller
// y is higher, 1024 angle units per turn. Soft billboard textures only.
(
    fps: 30,
    layers: [
        // Pale rays rising around the body.
        (
            textures: ["ro://data/texture/effect/light_y_01.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 278.0), quad: (70.0, 40.0), color: (190, 220, 255, 0) ),
                ( at: 4, offset: (319.0, 246.0), quad: (120.0, 115.0), color: (200, 225, 255, 210) ),
                ( at: 14, offset: (319.0, 228.0), quad: (130.0, 145.0), color: (190, 215, 255, 120) ),
                ( at: 24, offset: (319.0, 212.0), quad: (135.0, 160.0), color: (180, 210, 255, 0) ),
            ],
        ),
        // First white aura pulse, a halo around the body.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 242.0), quad: (40.0, 40.0), color: (235, 245, 255, 0) ),
                ( at: 3, offset: (319.0, 242.0), quad: (150.0, 165.0), color: (235, 245, 255, 255) ),
                ( at: 12, offset: (319.0, 242.0), quad: (190.0, 205.0), color: (215, 230, 255, 0) ),
            ],
        ),
        // Second pulse, the "double" of the reference.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 7, offset: (319.0, 242.0), quad: (40.0, 40.0), color: (235, 245, 255, 0) ),
                ( at: 10, offset: (319.0, 242.0), quad: (140.0, 155.0), color: (235, 245, 255, 235) ),
                ( at: 19, offset: (319.0, 242.0), quad: (180.0, 195.0), color: (215, 230, 255, 0) ),
            ],
        ),
        // Soft glow giving the light blade its body.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 3, offset: (319.0, 225.0), quad: (14.0, 40.0), color: (170, 205, 255, 0) ),
                ( at: 8, offset: (319.0, 170.0), quad: (34.0, 175.0), color: (180, 215, 255, 220) ),
