                ( at: 25, offset: (319.0, 154.0), quad: (20.0, 150.0), color: (150, 190, 255, 0) ),
            ],
        ),
        // Blade of light rising out of the body to stand over the head.
        (
            textures: ["ro://data/texture/effect/line.bmp"],
            blend: Add,
            keys: [
                ( at: 3, offset: (319.0, 230.0), quad: (60.0, 24.0), color: (220, 240, 255, 0), angle: 256.0 ),
                ( at: 8, offset: (319.0, 170.0), quad: (170.0, 44.0), color: (235, 245, 255, 255), angle: 256.0 ),
                ( at: 16, offset: (319.0, 162.0), quad: (176.0, 40.0), color: (225, 238, 255, 230), angle: 256.0 ),
                ( at: 25, offset: (319.0, 154.0), quad: (150.0, 20.0), color: (210, 230, 255, 0), angle: 256.0 ),
