            color: (1.0, 0.92, 0.65, 0.55),
            repeating: true,
        ),
        62: ( // EFST_DEFENDER -- pale cyan shield loop.
            visuals: [Str("crusader_shield_aura.strfx.ron")],
            sound: None,
            placement: Caster,
            color: (0.7, 0.95, 0.95, 0.55),
