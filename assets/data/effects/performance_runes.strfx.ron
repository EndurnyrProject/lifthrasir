// A Poem of Bragi field: one blue-violet glyph per server footprint cell.
// Motif reference: roBrowserLegacy src/Renderer/Effects/Songs.js (BragiSpellEffect).
// Cycle the retail glyphs within one motif rather than stacking three per cell.
(
    fps: 30,
    layers: [
        (
            textures: [
                "ro://data/texture/effect/spell_01.bmp",
                "ro://data/texture/effect/spell_04.bmp",
                "ro://data/texture/effect/spell_08.bmp",
            ],
            blend: Blend,
            keys: [
                (at: 0, offset: (319.0, 275.0), quad: (28.0, 28.0), color: (156, 156, 255, 200), texture_index: 0),
                (at: 40, offset: (319.0, 267.0), quad: (28.0, 28.0), color: (156, 156, 255, 200), texture_index: 1),
                (at: 60, offset: (319.0, 263.0), quad: (28.0, 28.0), color: (156, 156, 255, 200), texture_index: 1),
                (at: 80, offset: (319.0, 267.0), quad: (28.0, 28.0), color: (156, 156, 255, 200), texture_index: 2),
                (at: 120, offset: (319.0, 275.0), quad: (28.0, 28.0), color: (156, 156, 255, 200), texture_index: 0),
            ],
        ),
    ],
)
