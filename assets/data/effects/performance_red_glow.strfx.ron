            textures: ["ro://data/texture/effect/lens_r.bmp"],
            blend: Add,
            keys: [
                (at: 0, offset: (319.0, 275.0), quad: (16.0, 32.0), color: (255, 255, 255, 180)),
                (at: 60, offset: (319.0, 263.0), quad: (16.0, 32.0), color: (255, 255, 255, 180)),
                (at: 120, offset: (319.0, 275.0), quad: (16.0, 32.0), color: (255, 255, 255, 180)),
            ],
        ),
    ],
)
