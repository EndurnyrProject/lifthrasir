// Fortune's Kiss (DC_FORTUNEKISS) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive, Blend = alpha (magenta-keyed sprites).
//
// Shape: three of the native kiss.bmp hearts sway up around the dancer's head,
// a treble clef rises with them, all over a soft pink glow.
(
    fps: 30,
    layers: [
        // Left heart.
        (
            textures: ["ro://data/texture/effect/kiss.bmp"],
            blend: Blend,
            keys: [
                ( at: 0,  offset: (296.0, 250.0), quad: (30.0, 30.0), color: (255, 255, 255, 0) ),
                ( at: 8,  offset: (292.0, 238.0), quad: (36.0, 36.0), color: (255, 255, 255, 235) ),
                ( at: 22, offset: (298.0, 218.0), quad: (36.0, 36.0), color: (255, 255, 255, 220) ),
                ( at: 36, offset: (292.0, 198.0), quad: (32.0, 32.0), color: (255, 255, 255, 0) ),
            ],
        ),
        // Centre heart, highest.
        (
            textures: ["ro://data/texture/effect/kiss.bmp"],
            blend: Blend,
            keys: [
                ( at: 4,  offset: (320.0, 246.0), quad: (30.0, 30.0), color: (255, 255, 255, 0) ),
                ( at: 12, offset: (322.0, 232.0), quad: (38.0, 38.0), color: (255, 255, 255, 240) ),
                ( at: 26, offset: (318.0, 208.0), quad: (38.0, 38.0), color: (255, 255, 255, 220) ),
                ( at: 40, offset: (320.0, 186.0), quad: (32.0, 32.0), color: (255, 255, 255, 0) ),
            ],
        ),
        // Right heart.
        (
            textures: ["ro://data/texture/effect/kiss.bmp"],
            blend: Blend,
            keys: [
                ( at: 8,  offset: (344.0, 250.0), quad: (30.0, 30.0), color: (255, 255, 255, 0) ),
                ( at: 16, offset: (348.0, 238.0), quad: (36.0, 36.0), color: (255, 255, 255, 235) ),
                ( at: 30, offset: (342.0, 218.0), quad: (36.0, 36.0), color: (255, 255, 255, 220) ),
                ( at: 44, offset: (348.0, 198.0), quad: (32.0, 32.0), color: (255, 255, 255, 0) ),
            ],
        ),
        // Treble clef drifting up beside the hearts.
        (
            textures: ["ro://data/texture/effect/ws5.bmp"],
            blend: Blend,
            keys: [
                ( at: 6,  offset: (334.0, 256.0), quad: (22.0, 22.0), color: (255, 230, 240, 0) ),
                ( at: 14, offset: (332.0, 244.0), quad: (26.0, 26.0), color: (255, 230, 240, 220) ),
                ( at: 30, offset: (336.0, 224.0), quad: (26.0, 26.0), color: (255, 230, 240, 200) ),
                ( at: 44, offset: (334.0, 206.0), quad: (24.0, 24.0), color: (255, 230, 240, 0) ),
            ],
        ),
        // Pink glow behind the dancer.
        (
            textures: ["ro://data/texture/effect/lens_r.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 240.0), quad: (60.0, 60.0),   color: (255, 150, 200, 0) ),
                ( at: 12, offset: (319.0, 236.0), quad: (130.0, 130.0), color: (255, 160, 210, 110) ),
                ( at: 44, offset: (319.0, 226.0), quad: (150.0, 150.0), color: (255, 150, 200, 0) ),
            ],
        ),
    ],
)
