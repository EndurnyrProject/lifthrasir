// Charge Attack (KN_CHARGEATK) - authored effect.
//
// Convention (see fire_bolt.strfx.ron / systems.rs): offset & quad in STR pixels,
// anchor at (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30,
// linear key lerp, Add = additive.
//
// Shape: a body-slam rush impact on the target -- a hard white core flash, a
// flat shockwave ring snapping outward along the ground, and a dust kick-up
// thrown forward off the hit. Hardcoded in the official client, no native
// STR. Neutral white/grey so it reads as raw force, not an element. ~20f.
(
    fps: 30,
    layers: [
        // Hard core flash at the point of impact.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 245.0), quad: (16.0, 16.0),   color: (255, 255, 255, 0) ),
                ( at: 2,  offset: (319.0, 245.0), quad: (140.0, 140.0), color: (255, 255, 255, 245) ),
                ( at: 7,  offset: (319.0, 245.0), quad: (190.0, 190.0), color: (235, 240, 255, 120) ),
                ( at: 12, offset: (319.0, 245.0), quad: (220.0, 220.0), color: (220, 230, 250, 0) ),
            ],
        ),
        // Ground shockwave ring.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 291.0), quad: (30.0, 18.0),   color: (255, 255, 255, 0) ),
                ( at: 6,  offset: (319.0, 291.0), quad: (240.0, 135.0), color: (245, 248, 255, 220) ),
                ( at: 13, offset: (319.0, 291.0), quad: (380.0, 215.0), color: (225, 235, 250, 100) ),
                ( at: 19, offset: (319.0, 291.0), quad: (440.0, 250.0), color: (210, 225, 245, 0) ),
            ],
        ),
        // Dust thrown up off the slam.
        (
            textures: ["ro://data/texture/effect/dust_blast.bmp"],
            blend: Add,
            keys: [
                ( at: 2,  offset: (319.0, 285.0), quad: (50.0, 38.0),   color: (190, 185, 175, 0) ),
                ( at: 7,  offset: (319.0, 272.0), quad: (160.0, 120.0), color: (205, 200, 190, 170) ),
                ( at: 14, offset: (319.0, 258.0), quad: (220.0, 160.0), color: (185, 180, 170, 80) ),
                ( at: 20, offset: (319.0, 246.0), quad: (260.0, 185.0), color: (165, 160, 150, 0) ),
            ],
        ),
    ],
)
