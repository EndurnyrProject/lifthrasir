        197: ( // EFST_SHRINK (cr_shrink) -- pale violet defensive loop.
               // Dormant: aesir has no Shrink skill implementation yet.
            visuals: [Str("shrink_aura.strfx.ron")],
            sound: None,
            placement: Caster,
            color: (0.9, 0.9, 1.0, 0.55),
            repeating: true,
        ),
    },
    skills: {
        5: ( // SM_BASH — hardcoded in the official client, no native STR; authored slash.
