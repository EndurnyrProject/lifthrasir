// Acid Terror (AM_ACIDTERROR) -- authored effect, approximation.
//
// No reference artwork: roBrowserLegacy's `SkillEffect.js` has no
// AM_ACIDTERROR entry (the official client renders it with a hardcoded
// emitter). Aesir's `am_acidterror.ex` reports a single weapon hit per victim
// (`hit_count: 1`, never misses), so this impact plays once per damaged victim
// from the damage event, and never on a miss (the skill cannot miss).
//
// Convention: offset & quad are STR pixels, (319, 291) is the anchor (the
// victim's feet), a smaller offset.y renders higher. fps 30, keys lerp and
// texture_index is held (flipbook). All layers are additive because the retail
// bitmaps carry a transparency-colour background, not an alpha channel.
//
// Shape: the acid flask bursts against the body -- a green core flash, a
// droplet spray thrown outward, bubbles popping in the splash and a low
// corrosive vapour. Element is Neutral in both modes; the green reads the acid,
// not an element.
(
    fps: 30,
    layers: [
        // The flask breaking: hot green core flash.
        (
            textures: ["ro://data/texture/effect/lens_g.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 250.0), quad: (24.0, 24.0),   color: (170, 255, 150, 0) ),
                ( at: 3,  offset: (319.0, 250.0), quad: (120.0, 120.0), color: (200, 255, 170, 235) ),
                ( at: 9,  offset: (319.0, 250.0), quad: (160.0, 160.0), color: (150, 240, 120, 120) ),
                ( at: 16, offset: (319.0, 250.0), quad: (200.0, 200.0), color: (110, 200, 90, 0) ),
            ],
        ),
        // Droplet spray thrown off the burst.
        (
            textures: [
                "ro://data/texture/effect/water_splash/water_slplash_00.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_01.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_02.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_03.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_04.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_05.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_06.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_07.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_08.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_09.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 248.0), quad: (50.0, 50.0),   color: (180, 255, 155, 0),   texture_index: 0 ),
                ( at: 4,  offset: (319.0, 248.0), quad: (120.0, 120.0), color: (195, 255, 165, 220), texture_index: 2 ),
                ( at: 9,  offset: (319.0, 250.0), quad: (170.0, 170.0), color: (175, 250, 145, 170), texture_index: 5 ),
                ( at: 15, offset: (319.0, 252.0), quad: (210.0, 210.0), color: (150, 235, 125, 90),  texture_index: 8 ),
                ( at: 22, offset: (319.0, 254.0), quad: (240.0, 240.0), color: (120, 210, 100, 0),   texture_index: 9 ),
            ],
        ),
        // Acid bubbles popping in the splash.
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 4,  offset: (292.0, 268.0), quad: (10.0, 10.0), color: (200, 255, 170, 0) ),
                ( at: 7,  offset: (283.0, 258.0), quad: (24.0, 24.0), color: (215, 255, 185, 235) ),
                ( at: 14, offset: (270.0, 246.0), quad: (16.0, 16.0), color: (180, 240, 150, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 5,  offset: (346.0, 266.0), quad: (10.0, 10.0), color: (200, 255, 170, 0) ),
                ( at: 9,  offset: (357.0, 254.0), quad: (24.0, 24.0), color: (215, 255, 185, 235) ),
                ( at: 16, offset: (370.0, 242.0), quad: (16.0, 16.0), color: (180, 240, 150, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 3,  offset: (319.0, 262.0), quad: (12.0, 12.0), color: (205, 255, 175, 0) ),
                ( at: 7,  offset: (319.0, 232.0), quad: (26.0, 26.0), color: (220, 255, 190, 235) ),
                ( at: 15, offset: (319.0, 198.0), quad: (18.0, 18.0), color: (185, 245, 155, 0) ),
            ],
        ),
        // Corrosive vapour settling at the victim's feet.
        (
            textures: ["ro://data/texture/effect/poison_smoke.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 284.0), quad: (70.0, 46.0),  color: (110, 190, 90, 0) ),
                ( at: 12, offset: (319.0, 274.0), quad: (120.0, 76.0), color: (130, 210, 105, 110) ),
                ( at: 20, offset: (319.0, 258.0), quad: (150.0, 96.0), color: (100, 175, 85, 70) ),
                ( at: 30, offset: (319.0, 236.0), quad: (170.0, 110.0), color: (70, 130, 60, 0) ),
            ],
        ),
    ],
)
