        // pass). The cast bursts live in `skills:` below.
        58: ( // EFST_AUTOGUARD -- cool blue shield loop.
            visuals: [Str("crusader_shield_aura.strfx.ron")],
            sound: None,
            placement: Caster,
            color: (0.55, 0.75, 1.0, 0.55),
            repeating: true,
        ),
        59: ( // EFST_REFLECTSHIELD -- warm gold shield loop.
            visuals: [Str("crusader_shield_aura.strfx.ron")],
