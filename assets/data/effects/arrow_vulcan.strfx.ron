// Arrow Vulcan (CG_ARROWVULCAN) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive. Angles are raw STR units (1024 per turn).
//
// Shape: the Clown/Gypsy signature volley -- a dense gold-white flurry of six
// arrows hammering the torso in rapid succession. The warm tint reads as the
// bard's own barrage, distinct from the cool two-shot Double Strafe and the
// broad scattered Arrow Shower. ~22f so the flurry stays one burst.
(
    fps: 30,
    layers: [
        // Arrow 1: upper-left, first to land.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (262.0, 196.0), quad: (24.0, 6.0),   color: (255, 240, 195, 0),   angle: 128.0 ),
                ( at: 2, offset: (292.0, 228.0), quad: (108.0, 22.0), color: (255, 245, 205, 235), angle: 128.0 ),
                ( at: 4, offset: (310.0, 240.0), quad: (126.0, 25.0), color: (255, 232, 170, 0),   angle: 128.0 ),
            ],
        ),
        // Arrow 2: upper-right, a beat behind.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 2, offset: (376.0, 196.0), quad: (24.0, 6.0),   color: (255, 240, 195, 0),   angle: -128.0 ),
                ( at: 4, offset: (346.0, 228.0), quad: (108.0, 22.0), color: (255, 245, 205, 235), angle: -128.0 ),
                ( at: 6, offset: (328.0, 240.0), quad: (126.0, 25.0), color: (255, 232, 170, 0),   angle: -128.0 ),
            ],
        ),
        // Arrow 3: near-horizontal from the left.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 4, offset: (258.0, 232.0), quad: (22.0, 6.0),   color: (255, 240, 195, 0),   angle: 96.0 ),
                ( at: 6, offset: (296.0, 238.0), quad: (100.0, 21.0), color: (255, 245, 205, 240), angle: 96.0 ),
                ( at: 8, offset: (314.0, 241.0), quad: (120.0, 24.0), color: (255, 232, 170, 0),   angle: 96.0 ),
            ],
        ),
        // Arrow 4: near-horizontal from the right.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 6, offset: (380.0, 232.0), quad: (22.0, 6.0),   color: (255, 240, 195, 0),   angle: -96.0 ),
                ( at: 8, offset: (342.0, 238.0), quad: (100.0, 21.0), color: (255, 245, 205, 240), angle: -96.0 ),
                ( at: 10, offset: (324.0, 241.0), quad: (120.0, 24.0), color: (255, 232, 170, 0),   angle: -96.0 ),
            ],
        ),
        // Arrow 5: dropping from above.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 8,  offset: (300.0, 190.0), quad: (22.0, 6.0),   color: (255, 240, 195, 0),   angle: 64.0 ),
                ( at: 10, offset: (314.0, 230.0), quad: (104.0, 22.0), color: (255, 245, 205, 240), angle: 64.0 ),
                ( at: 12, offset: (319.0, 240.0), quad: (124.0, 25.0), color: (255, 232, 170, 0),   angle: 64.0 ),
            ],
        ),
        // Arrow 6: rising from below to close the volley.
        (
            textures: ["ro://data/texture/effect/spear.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (270.0, 268.0), quad: (22.0, 6.0),   color: (255, 240, 195, 0),   angle: 200.0 ),
                ( at: 12, offset: (300.0, 248.0), quad: (100.0, 21.0), color: (255, 245, 205, 240), angle: 200.0 ),
                ( at: 14, offset: (315.0, 242.0), quad: (118.0, 24.0), color: (255, 232, 170, 0),   angle: 200.0 ),
            ],
        ),
        // Warm impact flash where the volley concentrates.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 12, offset: (319.0, 240.0), quad: (18.0, 18.0),   color: (255, 245, 200, 0) ),
                ( at: 14, offset: (319.0, 240.0), quad: (120.0, 120.0), color: (255, 240, 180, 235) ),
                ( at: 18, offset: (319.0, 240.0), quad: (150.0, 150.0), color: (255, 228, 160, 0) ),
            ],
        ),
        // Lingering afterglow.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 16, offset: (319.0, 242.0), quad: (16.0, 16.0),   color: (255, 240, 190, 0) ),
                ( at: 18, offset: (319.0, 242.0), quad: (90.0, 90.0),   color: (255, 235, 175, 200) ),
                ( at: 22, offset: (319.0, 242.0), quad: (110.0, 110.0), color: (255, 225, 150, 0) ),
            ],
        ),
    ],
)
