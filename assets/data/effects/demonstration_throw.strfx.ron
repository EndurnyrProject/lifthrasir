                ( at: 18, offset: (346.0, 238.0), quad: (14.0, 14.0), color: (255, 190, 110, 230) ),
                ( at: 25, offset: (356.0, 266.0), quad: (8.0, 8.0),   color: (255, 140, 70, 0) ),
            ],
        ),
        // Heat glow pooling on the ground across the 3x3 the field reaches.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (319.0, 291.0), quad: (60.0, 20.0),   color: (255, 140, 60, 0) ),
                ( at: 14, offset: (319.0, 291.0), quad: (200.0, 60.0),  color: (255, 150, 70, 200) ),
                ( at: 30, offset: (319.0, 291.0), quad: (230.0, 70.0),  color: (255, 120, 50, 120) ),
                ( at: 42, offset: (319.0, 291.0), quad: (240.0, 72.0),  color: (220, 90, 40, 0) ),
            ],
        ),
        // Smoke rising off the burn.
        (
            textures: ["ro://data/texture/effect/dust_blast.bmp"],
            blend: Add,
            keys: [
                ( at: 14, offset: (319.0, 266.0), quad: (70.0, 70.0),   color: (120, 100, 80, 0) ),
                ( at: 22, offset: (319.0, 236.0), quad: (120.0, 120.0), color: (120, 100, 80, 120) ),
