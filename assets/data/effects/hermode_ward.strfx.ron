// Hermode's Rod (CG_HERMODE) - authored cast effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive, Blend = alpha (magenta-keyed sprites).
//
// Shape: the caster plants the rod and the anti-magic ward snaps up -- a pale
// blue rune sigil blooms behind the performer, a sealing ring clamps outward
// along the ground, and a cold note rises as the block settles. Reads as magic
// being locked out, not a plain song note. The field cells are server-owned and
// draw the `skill_units` ward motif; this is only the cast (~38f).
(
    fps: 30,
    layers: [
        // Anti-magic rune sigil blooming behind the performer.
        (
            textures: ["ro://data/texture/effect/spell_04.bmp"],
            blend: Blend,
            keys: [
                ( at: 0,  offset: (319.0, 216.0), quad: (24.0, 24.0),   color: (185, 205, 255, 0),   angle: 0.0 ),
                ( at: 8,  offset: (319.0, 214.0), quad: (90.0, 90.0), color: (205, 220, 255, 220), angle: 40.0 ),
                ( at: 24, offset: (319.0, 212.0), quad: (90.0, 90.0), color: (190, 208, 255, 150), angle: 110.0 ),
                ( at: 38, offset: (319.0, 210.0), quad: (90.0, 90.0), color: (175, 195, 250, 0),   angle: 170.0 ),
            ],
        ),
        // Cold flare sealing at the chest.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 2,  offset: (319.0, 240.0), quad: (20.0, 20.0),   color: (200, 220, 255, 0) ),
                ( at: 7,  offset: (319.0, 240.0), quad: (110.0, 110.0), color: (215, 232, 255, 230) ),
                ( at: 18, offset: (319.0, 240.0), quad: (140.0, 140.0), color: (195, 215, 255, 110) ),
                ( at: 30, offset: (319.0, 240.0), quad: (160.0, 160.0), color: (180, 200, 250, 0) ),
            ],
        ),
        // Sealing ring clamping outward along the ground.
        (
            textures: ["ro://data/texture/effect/ring_b.bmp"],
            blend: Add,
            keys: [
                ( at: 5,  offset: (319.0, 287.0), quad: (40.0, 12.0),   color: (185, 205, 255, 0) ),
                ( at: 11, offset: (319.0, 287.0), quad: (220.0, 66.0), color: (205, 222, 255, 220) ),
                ( at: 24, offset: (319.0, 287.0), quad: (360.0, 108.0), color: (185, 205, 255, 120) ),
                ( at: 36, offset: (319.0, 287.0), quad: (420.0, 126.0), color: (170, 190, 248, 0) ),
            ],
        ),
        // Cold note rising as the block settles.
        (
            textures: ["ro://data/texture/effect/ws1.bmp"],
            blend: Blend,
            keys: [
                ( at: 4,  offset: (326.0, 246.0), quad: (20.0, 20.0), color: (200, 220, 255, 0),   angle: 0.0 ),
                ( at: 11, offset: (330.0, 234.0), quad: (24.0, 24.0), color: (215, 230, 255, 220), angle: 60.0 ),
                ( at: 26, offset: (336.0, 214.0), quad: (24.0, 24.0), color: (210, 225, 255, 190), angle: 160.0 ),
                ( at: 38, offset: (342.0, 194.0), quad: (22.0, 22.0), color: (200, 220, 255, 0),   angle: 240.0 ),
            ],
        ),
    ],
)
