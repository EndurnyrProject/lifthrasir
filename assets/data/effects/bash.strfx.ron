// Bash (SM_BASH) - authored effect.
//
// Convention (see fire_bolt.strfx.ron / systems.rs): offset & quad in STR pixels,
// anchor at (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30,
// linear key lerp, Add = additive. Angles are raw STR units (1024 per turn).
//
// Shape: a single heavy diagonal slash snaps across the target's torso with a
// gold impact flash behind it, plus a thinner counter-slash a beat later for
// snap. Replaces the old procedural "bash" flash burst. ~12f.
(
    fps: 30,
    layers: [
        // Main diagonal slash streak.
        (
            textures: ["ro://data/texture/effect/e9_counter_slash.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 235.0), quad: (50.0, 24.0),   color: (255, 255, 255, 0),   angle: -128.0 ),
                ( at: 2,  offset: (319.0, 235.0), quad: (230.0, 110.0), color: (255, 250, 235, 255), angle: -128.0 ),
                ( at: 6,  offset: (319.0, 235.0), quad: (270.0, 130.0), color: (255, 240, 200, 150), angle: -128.0 ),
                ( at: 11, offset: (319.0, 235.0), quad: (300.0, 145.0), color: (255, 230, 180, 0),   angle: -128.0 ),
            ],
        ),
        // Thinner counter-slash, opposite diagonal, one beat behind.
        (
            textures: ["ro://data/texture/effect/e9_counter_slash.tga"],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 238.0), quad: (36.0, 16.0),   color: (255, 240, 180, 0),   angle: 128.0 ),
                ( at: 3,  offset: (319.0, 238.0), quad: (170.0, 75.0),  color: (255, 238, 175, 210), angle: 128.0 ),
                ( at: 8,  offset: (319.0, 238.0), quad: (220.0, 95.0),  color: (255, 225, 155, 0),   angle: 128.0 ),
            ],
        ),
        // Gold impact flash behind the slashes.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 238.0), quad: (14.0, 14.0),   color: (255, 240, 190, 0) ),
                ( at: 2, offset: (319.0, 238.0), quad: (130.0, 130.0), color: (255, 242, 195, 230) ),
                ( at: 8, offset: (319.0, 238.0), quad: (180.0, 180.0), color: (255, 232, 175, 0) ),
            ],
        ),
    ],
)
