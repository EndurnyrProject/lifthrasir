// Moonlit Water Mill / Sheltering Bliss (CG_MOONLIT) - authored cast effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive, Blend = alpha (magenta-keyed sprites).
//
// Shape: the ensemble begins -- a pale moon-bloom opens behind the performer,
// cool moonlight ripples out along the ground as the sheltering field takes
// hold, and soft notes drift up through it. Reads as a protective barrier
// rising, not a plain song note. The persistent field cells are server-owned
// and draw the `skill_units` motif; this is only the cast (~40f).
(
    fps: 30,
    layers: [
        // Moon-bloom opening behind the performer.
        (
            textures: ["ro://data/texture/effect/magic_blue.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 214.0), quad: (30.0, 30.0),   color: (170, 195, 255, 0) ),
                ( at: 10, offset: (319.0, 212.0), quad: (110.0, 110.0), color: (190, 210, 255, 200) ),
                ( at: 26, offset: (319.0, 210.0), quad: (140.0, 140.0), color: (175, 198, 255, 120) ),
                ( at: 40, offset: (319.0, 208.0), quad: (160.0, 160.0), color: (160, 185, 250, 0) ),
            ],
        ),
        // Moonlight ripple racing out along the ground.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 4,  offset: (319.0, 291.0), quad: (40.0, 20.0),   color: (170, 195, 255, 0) ),
                ( at: 10, offset: (319.0, 291.0), quad: (220.0, 110.0), color: (195, 215, 255, 210) ),
                ( at: 26, offset: (319.0, 291.0), quad: (380.0, 190.0), color: (175, 198, 255, 110) ),
                ( at: 40, offset: (319.0, 291.0), quad: (440.0, 220.0), color: (160, 185, 250, 0) ),
            ],
        ),
        // Cold note drifting up on the left.
        (
            textures: ["ro://data/texture/effect/ws1.bmp"],
            blend: Blend,
            keys: [
                ( at: 2,  offset: (306.0, 246.0), quad: (20.0, 20.0), color: (200, 220, 255, 0),   angle: 0.0 ),
                ( at: 9,  offset: (302.0, 234.0), quad: (24.0, 24.0), color: (215, 230, 255, 220), angle: 60.0 ),
                ( at: 24, offset: (296.0, 214.0), quad: (24.0, 24.0), color: (210, 225, 255, 190), angle: 160.0 ),
                ( at: 38, offset: (290.0, 194.0), quad: (22.0, 22.0), color: (200, 220, 255, 0),   angle: 240.0 ),
            ],
        ),
        // Cold note drifting up on the right, a beat later.
        (
            textures: ["ro://data/texture/effect/ws3.bmp"],
            blend: Blend,
            keys: [
                ( at: 6,  offset: (332.0, 248.0), quad: (20.0, 20.0), color: (200, 220, 255, 0),   angle: 0.0 ),
                ( at: 13, offset: (336.0, 236.0), quad: (24.0, 24.0), color: (215, 230, 255, 220), angle: -60.0 ),
                ( at: 28, offset: (342.0, 216.0), quad: (24.0, 24.0), color: (210, 225, 255, 190), angle: -160.0 ),
                ( at: 42, offset: (348.0, 196.0), quad: (22.0, 22.0), color: (200, 220, 255, 0),   angle: -240.0 ),
            ],
        ),
        // Faint sheltering glow at the performer.
        (
            textures: ["ro://data/texture/effect/lens_b.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 240.0), quad: (60.0, 60.0),   color: (180, 205, 255, 0) ),
                ( at: 12, offset: (319.0, 238.0), quad: (130.0, 130.0), color: (195, 218, 255, 100) ),
                ( at: 40, offset: (319.0, 232.0), quad: (150.0, 150.0), color: (175, 198, 255, 0) ),
            ],
        ),
    ],
)
