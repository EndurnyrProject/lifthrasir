// Magnum Break (SM_MAGNUM): the reference draws flat yellow rings spreading
// out on the ground and a fire sphere around the caster. Here a flattened fire
// ring sweeps out at the feet twice, a native explosion flipbook (폭발1..8)
// bursts on the body, and a warm flash lights it. ~0.6s.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the anchor's feet, smaller
// y is higher, 1024 angle units per turn. Soft billboard textures only: the
// ring_*/lens_* bands are cylinder wraps and read as boxes when drawn flat.
(
    fps: 30,
    layers: [
        // Warm flash.
        (
            textures: ["ro://data/texture/effect/glow01.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 250.0), quad: (40.0, 40.0), color: (255, 200, 120, 0) ),
                ( at: 2, offset: (319.0, 250.0), quad: (170.0, 170.0), color: (255, 210, 130, 255) ),
                ( at: 12, offset: (319.0, 250.0), quad: (200.0, 200.0), color: (255, 150, 60, 0) ),
            ],
        ),
        // Ground fire ring.
        (
            textures: ["ro://data/texture/effect/firering.tga"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 287.0), quad: (40.0, 12.0), color: (255, 220, 150, 0) ),
                ( at: 3, offset: (319.0, 287.0), quad: (170.0, 50.0), color: (255, 220, 150, 255) ),
                ( at: 14, offset: (319.0, 287.0), quad: (290.0, 85.0), color: (255, 160, 80, 0) ),
            ],
        ),
        // Second, later ring.
        (
            textures: ["ro://data/texture/effect/firering.tga"],
            blend: Add,
            keys: [
                ( at: 3, offset: (319.0, 287.0), quad: (40.0, 12.0), color: (255, 230, 170, 0) ),
                ( at: 6, offset: (319.0, 287.0), quad: (140.0, 42.0), color: (255, 230, 170, 220) ),
                ( at: 18, offset: (319.0, 287.0), quad: (250.0, 75.0), color: (255, 170, 90, 0) ),
            ],
        ),
        // Explosion flipbook on the body.
        (
            textures: [
                "ro://data/texture/effect/폭발1.tga",
                "ro://data/texture/effect/폭발2.tga",
                "ro://data/texture/effect/폭발3.tga",
                "ro://data/texture/effect/폭발4.tga",
                "ro://data/texture/effect/폭발5.tga",
                "ro://data/texture/effect/폭발6.tga",
                "ro://data/texture/effect/폭발7.tga",
                "ro://data/texture/effect/폭발8.tga",
            ],
            blend: Add,
            keys: [
                ( at: 1, offset: (319.0, 245.0), quad: (60.0, 60.0), color: (255, 255, 255, 0), texture_index: 0 ),
                ( at: 2, offset: (319.0, 245.0), quad: (110.0, 110.0), color: (255, 255, 255, 255), texture_index: 0 ),
                ( at: 4, offset: (319.0, 243.0), quad: (120.0, 120.0), color: (255, 255, 255, 255), texture_index: 1 ),
                ( at: 6, offset: (319.0, 241.0), quad: (130.0, 130.0), color: (255, 255, 255, 255), texture_index: 2 ),
                ( at: 8, offset: (319.0, 239.0), quad: (140.0, 140.0), color: (255, 255, 255, 255), texture_index: 3 ),
                ( at: 10, offset: (319.0, 237.0), quad: (150.0, 150.0), color: (255, 255, 255, 255), texture_index: 4 ),
                ( at: 12, offset: (319.0, 235.0), quad: (160.0, 160.0), color: (255, 255, 255, 185), texture_index: 5 ),
                ( at: 14, offset: (319.0, 233.0), quad: (170.0, 170.0), color: (255, 255, 255, 115), texture_index: 6 ),
                ( at: 16, offset: (319.0, 231.0), quad: (180.0, 180.0), color: (255, 255, 255, 45), texture_index: 7 ),
                ( at: 19, offset: (319.0, 228.0), quad: (190.0, 190.0), color: (255, 230, 200, 0), texture_index: 7 ),
            ],
        ),
    ],
)
