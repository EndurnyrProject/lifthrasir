// Acid Demonstration (CR_ACIDDEMONSTRATION) -- authored effect, approximation.
//
// Reference: roBrowserLegacy maps CR_ACIDDEMONSTRATION to EF_ACIDDEMON (537),
// a 650 ms camera quake and nothing else (the quake is the catalog's `shake`).
// The skill consumes an Acid Bottle and a Bottle Grenade, so this pairs the
// two item icons with a heavier version of acid_terror.strfx.ron.
// Aesir splits one never-missing hit by skill level; this plays once per
// damaged victim.
//
// Convention: offset & quad are STR pixels, (319, 291) is the anchor (the
// victim's feet), a smaller offset.y renders higher; a character is ~100 px
// tall. fps 30, keys lerp and texture_index is held (flipbook). Angle is raw
// STR units, 1024 per turn. Avoid `lens_*`, `ring_*` and `water_slplash`
// frames on big quads: they are cylinder strips and render as bars.
//
// Shape: both bottles spin onto the chest from either side, burst in a white-
// green flash with a fire core, a tall acid cloud and a second, later cloud,
// droplets arcing out, and a corrosive vapour that lingers at the feet.
(
    fps: 30,
    layers: [
        // The Acid Bottle, from the upper left.
        (
            textures: ["ro://data/texture/유저인터페이스/item/염산병.bmp"],
            blend: Blend,
            keys: [
                ( at: 0, offset: (271.0, 160.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: 0.0 ),
                ( at: 1, offset: (280.0, 174.0), quad: (28.0, 28.0), color: (255, 255, 255, 255), angle: 180.0 ),
                ( at: 6, offset: (313.0, 228.0), quad: (28.0, 28.0), color: (255, 255, 255, 255), angle: 980.0 ),
                ( at: 7, offset: (317.0, 236.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: 1140.0 ),
            ],
        ),
        // The Fire Bottle, from the upper right, spinning the other way.
        (
            textures: ["ro://data/texture/유저인터페이스/item/화염병.bmp"],
            blend: Blend,
            keys: [
                ( at: 0, offset: (367.0, 164.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: 0.0 ),
                ( at: 1, offset: (358.0, 178.0), quad: (28.0, 28.0), color: (255, 255, 255, 255), angle: -180.0 ),
                ( at: 6, offset: (325.0, 230.0), quad: (28.0, 28.0), color: (255, 255, 255, 255), angle: -980.0 ),
                ( at: 7, offset: (321.0, 238.0), quad: (24.0, 24.0), color: (255, 255, 255, 0),   angle: -1140.0 ),
            ],
        ),
        // Burst flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 236.0), quad: (20.0, 20.0),   color: (220, 255, 190, 0) ),
                ( at: 8,  offset: (319.0, 236.0), quad: (180.0, 180.0), color: (230, 255, 200, 255) ),
                ( at: 14, offset: (319.0, 236.0), quad: (220.0, 220.0), color: (130, 235, 110, 130) ),
                ( at: 22, offset: (319.0, 236.0), quad: (240.0, 240.0), color: (80, 180, 70, 0) ),
            ],
        ),
        // Fire core, the Fire Bottle's half of the reaction.
        (
            textures: ["ro://data/texture/effect/fire_smoke_a.bmp"],
            blend: Add,
            keys: [
