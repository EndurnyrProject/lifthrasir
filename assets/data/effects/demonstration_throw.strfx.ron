                ( at: 17, offset: (310.0, 196.0), quad: (18.0, 18.0), color: (255, 195, 115, 230) ),
                ( at: 27, offset: (304.0, 214.0), quad: (10.0, 10.0), color: (255, 140, 70, 0) ),
            ],
