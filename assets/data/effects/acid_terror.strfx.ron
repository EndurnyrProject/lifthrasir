// Acid Terror (AM_ACIDTERROR) -- authored effect, approximation.
//
// Reference: roBrowserLegacy maps AM_ACIDTERROR to EF_THROWITEM (298), the
// Acid Bottle item icon spinning from caster to target; no impact art exists.
// Aesir's `am_acidterror.ex` reports one weapon hit per victim (`hit_count: 1`,
// never misses), so this plays once per damaged victim from the damage event.
// It is anchored on the victim, so the bottle drops in from above instead of
// flying from the caster.
//
// Convention: offset & quad are STR pixels, (319, 291) is the anchor (the
// victim's feet), a smaller offset.y renders higher; a character is ~100 px
// tall. fps 30, keys lerp and texture_index is held (flipbook). Angle is raw
// STR units, 1024 per turn. Avoid `lens_*`, `ring_*` and `water_slplash`:
// they are cylinder strips and render as bars on a flat quad.
//
// Shape: the bottle spins onto the chest, bursts in a green flash and acid
// cloud, throws droplets that arc down, and leaves a low corrosive vapour.
// Element is Neutral; the green reads the acid, not an element.
(
    fps: 30,
    layers: [
        // The Acid Bottle, magenta-keyed item icon.
        (
            textures: ["ro://data/texture/유저인터페이스/item/염산병.bmp"],
            blend: Blend,
            keys: [
                ( at: 0, offset: (281.0, 168.0), quad: (22.0, 22.0), color: (255, 255, 255, 0),   angle: 0.0 ),
                ( at: 1, offset: (289.0, 182.0), quad: (24.0, 24.0), color: (255, 255, 255, 255), angle: 160.0 ),
                ( at: 5, offset: (314.0, 228.0), quad: (24.0, 24.0), color: (255, 255, 255, 255), angle: 800.0 ),
                ( at: 6, offset: (319.0, 238.0), quad: (22.0, 22.0), color: (255, 255, 255, 0),   angle: 960.0 ),
            ],
        ),
        // Burst flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 5,  offset: (319.0, 238.0), quad: (20.0, 20.0),   color: (170, 255, 140, 0) ),
                ( at: 7,  offset: (319.0, 238.0), quad: (120.0, 120.0), color: (190, 255, 160, 255) ),
                ( at: 12, offset: (319.0, 238.0), quad: (150.0, 150.0), color: (120, 230, 100, 110) ),
                ( at: 19, offset: (319.0, 238.0), quad: (165.0, 165.0), color: (80, 180, 70, 0) ),
            ],
        ),
        // Acid cloud.
        (
            textures: ["ro://data/texture/effect/poison_smoke.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 238.0), quad: (40.0, 40.0),   color: (180, 255, 150, 0) ),
                ( at: 9,  offset: (319.0, 236.0), quad: (110.0, 110.0), color: (190, 255, 160, 230) ),
                ( at: 18, offset: (319.0, 230.0), quad: (140.0, 140.0), color: (140, 230, 110, 110) ),
                ( at: 28, offset: (319.0, 224.0), quad: (150.0, 150.0), color: (90, 170, 70, 0) ),
            ],
        ),
        // Fine spray.
        (
            textures: [
                "ro://data/texture/effect/water_splash/water_slplash_03.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_05.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_07.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_09.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 238.0), quad: (60.0, 54.0),   color: (180, 255, 150, 0),   texture_index: 0 ),
                ( at: 9,  offset: (319.0, 240.0), quad: (120.0, 105.0), color: (190, 255, 160, 200), texture_index: 1 ),
                ( at: 14, offset: (319.0, 246.0), quad: (150.0, 130.0), color: (150, 235, 120, 120), texture_index: 2 ),
                ( at: 20, offset: (319.0, 254.0), quad: (165.0, 145.0), color: (110, 200, 90, 0),    texture_index: 3 ),
            ],
        ),
        // Droplets arcing out and dripping down.
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 7,  offset: (312.0, 238.0), quad: (14.0, 14.0), color: (200, 255, 170, 255) ),
                ( at: 12, offset: (282.0, 214.0), quad: (16.0, 16.0), color: (190, 255, 160, 230) ),
                ( at: 20, offset: (268.0, 262.0), quad: (10.0, 10.0), color: (130, 220, 110, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 7,  offset: (326.0, 238.0), quad: (14.0, 14.0), color: (200, 255, 170, 255) ),
                ( at: 13, offset: (358.0, 210.0), quad: (16.0, 16.0), color: (190, 255, 160, 230) ),
                ( at: 21, offset: (372.0, 260.0), quad: (10.0, 10.0), color: (130, 220, 110, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 8,  offset: (318.0, 234.0), quad: (12.0, 12.0), color: (205, 255, 175, 255) ),
                ( at: 13, offset: (306.0, 192.0), quad: (16.0, 16.0), color: (195, 255, 165, 230) ),
                ( at: 22, offset: (298.0, 236.0), quad: (10.0, 10.0), color: (130, 220, 110, 0) ),
            ],
        ),
        // Corrosive vapour at the feet.
        (
            textures: ["ro://data/texture/effect/poison_smoke.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (319.0, 288.0), quad: (60.0, 24.0),  color: (120, 200, 100, 0) ),
                ( at: 16, offset: (319.0, 284.0), quad: (120.0, 44.0), color: (130, 210, 105, 120) ),
                ( at: 28, offset: (319.0, 276.0), quad: (150.0, 56.0), color: (100, 175, 85, 60) ),
                ( at: 38, offset: (319.0, 268.0), quad: (160.0, 62.0), color: (70, 130, 60, 0) ),
            ],
        ),
    ],
)
