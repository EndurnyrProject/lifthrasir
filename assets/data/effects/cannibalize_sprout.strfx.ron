// Bio Cannibalize (AM_CANNIBALIZE) -- authored effect, approximation.
//
// No reference artwork: roBrowserLegacy's `SkillEffect.js` has no
// AM_CANNIBALIZE entry. Aesir's `am_cannibalize.ex` spawns a plant mob on the
// targeted cell (`Coordinator.summon_mob`, 60-300 s lifetime, per-class cap);
// the plant's own mob sprite is the persistent visual, so this descriptor is
// only the cast burst on the ground cell. Aesir sends one `GroundSkill`
// placement packet for it, so the effect plays once from that event and never
// per tick.
//
// Convention: (319, 291) is the anchor (the targeted ground cell), a smaller
// offset.y renders higher. fps 30, keys lerp and texture_index is held. All
// layers are additive (retail bitmaps use a transparency colour, not alpha).
//
// Shape: the Plant Bottle is smashed into the soil -- a dust bloom, a dust
// cloud rolling out, a green growth glow climbing out of the cell and a few
// leaves flicking up and away as the seed takes root.
(
    fps: 30,
    layers: [
        // Soil bursting where the bottle lands.
        (
            textures: ["ro://data/texture/effect/dust_blast.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 291.0), quad: (40.0, 34.0),   color: (200, 175, 130, 0) ),
                ( at: 4,  offset: (319.0, 288.0), quad: (130.0, 96.0),  color: (215, 190, 145, 210) ),
                ( at: 12, offset: (319.0, 284.0), quad: (190.0, 140.0), color: (195, 170, 130, 140) ),
                ( at: 22, offset: (319.0, 280.0), quad: (230.0, 170.0), color: (165, 145, 110, 0) ),
            ],
        ),
        // Dust cloud rolling out of the cell.
        (
            textures: [
                "ro://data/texture/effect/dust01.bmp",
                "ro://data/texture/effect/dust02.bmp",
                "ro://data/texture/effect/dust03.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 2,  offset: (319.0, 286.0), quad: (100.0, 64.0), color: (175, 155, 115, 0),   texture_index: 0 ),
                ( at: 7,  offset: (319.0, 282.0), quad: (150.0, 96.0), color: (195, 175, 130, 150), texture_index: 1 ),
                ( at: 16, offset: (319.0, 277.0), quad: (190.0, 120.0), color: (180, 160, 120, 110), texture_index: 2 ),
                ( at: 28, offset: (319.0, 272.0), quad: (220.0, 140.0), color: (150, 135, 100, 0),  texture_index: 2 ),
            ],
        ),
        // Green growth climbing out of the cell.
        (
            textures: ["ro://data/texture/effect/magic_green.tga"],
            blend: Add,
            keys: [
                ( at: 4,  offset: (319.0, 288.0), quad: (30.0, 30.0),  color: (150, 255, 140, 0) ),
                ( at: 9,  offset: (319.0, 274.0), quad: (90.0, 90.0),  color: (170, 255, 160, 190) ),
                ( at: 18, offset: (319.0, 252.0), quad: (130.0, 130.0), color: (140, 235, 125, 130) ),
                ( at: 30, offset: (319.0, 226.0), quad: (150.0, 150.0), color: (110, 200, 95, 0) ),
            ],
        ),
        // Leaves flicking up as the seed roots.
        (
            textures: ["ro://data/texture/effect/mus_leaf1.bmp"],
            blend: Add,
            keys: [
                ( at: 8,  offset: (305.0, 282.0), quad: (16.0, 16.0), color: (190, 255, 175, 0),   angle: -20.0 ),
                ( at: 12, offset: (289.0, 262.0), quad: (36.0, 36.0), color: (200, 255, 185, 225), angle: -120.0 ),
                ( at: 22, offset: (272.0, 236.0), quad: (26.0, 26.0), color: (170, 235, 150, 0),   angle: -220.0 ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/mus_leaf2.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (334.0, 280.0), quad: (16.0, 16.0), color: (190, 255, 175, 0),   angle: 25.0 ),
                ( at: 14, offset: (351.0, 258.0), quad: (36.0, 36.0), color: (200, 255, 185, 225), angle: 130.0 ),
                ( at: 24, offset: (368.0, 232.0), quad: (26.0, 26.0), color: (170, 235, 150, 0),   angle: 230.0 ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/mus_leaf3.bmp"],
            blend: Add,
            keys: [
                ( at: 9,  offset: (319.0, 276.0), quad: (14.0, 14.0), color: (195, 255, 180, 0),   angle: 0.0 ),
                ( at: 13, offset: (319.0, 246.0), quad: (32.0, 32.0), color: (205, 255, 190, 230), angle: 40.0 ),
                ( at: 24, offset: (319.0, 208.0), quad: (24.0, 24.0), color: (175, 240, 155, 0),   angle: 95.0 ),
            ],
        ),
    ],
)
