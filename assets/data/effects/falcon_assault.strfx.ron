// Falcon Assault (SN_FALCONASSAULT) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive, Blend = alpha (magenta-keyed sprites). Angles are
// raw STR units (1024 per turn).
//
// Shape: the falcon itself dives in. A gold-white bird (two wing000.bmp wings,
// the right one mirrored through xy corners) streaks down from the upper right
// on a glow trail, folding its wings, and slams into the target: a heavy gold
// flash, a big crossed talon X, shock rings, and a burst of feathers that
// drifts to the ground. ~1.1s; heavier and slower than Blitz Beat's staccato
// talon rakes, which have no bird.
(
    fps: 30,
    layers: [
        // Gold dive trail behind the falcon.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (473.4, 66.3), quad: (10.0, 14.0), color: (255, 225, 150, 0), angle: 378.1 ),
                ( at: 2, offset: (456.1, 84.9), quad: (70.0, 14.0), color: (255, 225, 150, 220), angle: 378.1 ),
                ( at: 4, offset: (435.4, 107.2), quad: (120.0, 14.0), color: (255, 225, 150, 230), angle: 378.1 ),
                ( at: 7, offset: (382.3, 164.4), quad: (130.0, 14.0), color: (255, 225, 150, 200), angle: 378.1 ),
                ( at: 10, offset: (368.6, 179.0), quad: (90.0, 14.0), color: (255, 225, 150, 0), angle: 378.1 ),
            ],
        ),
        // Falcon left wing (tips out to the left), folding into the dive.
        (
            textures: ["ro://data/texture/effect/wing000.bmp"],
            blend: Blend,
            keys: [
                ( at: 0, offset: (450.0, 70.0), quad: (40.0, 28.0), color: (255, 235, 190, 0) ),
                ( at: 1, offset: (431.1, 90.3), quad: (40.0, 24.0), color: (255, 235, 190, 255) ),
                ( at: 2, offset: (412.3, 110.6), quad: (40.0, 14.0), color: (255, 235, 190, 255) ),
                ( at: 4, offset: (378.6, 151.1), quad: (32.0, 24.0), color: (255, 235, 190, 255) ),
                ( at: 6, offset: (344.9, 191.7), quad: (24.0, 18.0), color: (255, 235, 190, 255) ),
                ( at: 8, offset: (328.0, 212.0), quad: (20.0, 14.0), color: (255, 235, 190, 0) ),
            ],
        ),
        // Falcon right wing, mirrored through xy corners.
        (
            textures: ["ro://data/texture/effect/wing000.bmp"],
            blend: Blend,
            keys: [
                ( at: 0, offset: (470.0, 70.0), xy: (40.0, 0.0, 0.0, 40.0, -14.0, -14.0, 14.0, 14.0), color: (255, 235, 190, 0) ),
                ( at: 1, offset: (451.1, 90.3), xy: (40.0, 0.0, 0.0, 40.0, -12.0, -12.0, 12.0, 12.0), color: (255, 235, 190, 255) ),
                ( at: 2, offset: (432.3, 110.6), xy: (40.0, 0.0, 0.0, 40.0, -7.0, -7.0, 7.0, 7.0), color: (255, 235, 190, 255) ),
                ( at: 4, offset: (394.6, 151.1), xy: (32.0, 0.0, 0.0, 32.0, -12.0, -12.0, 12.0, 12.0), color: (255, 235, 190, 255) ),
                ( at: 6, offset: (356.9, 191.7), xy: (24.0, 0.0, 0.0, 24.0, -9.0, -9.0, 9.0, 9.0), color: (255, 235, 190, 255) ),
                ( at: 8, offset: (338.0, 212.0), xy: (20.0, 0.0, 0.0, 20.0, -7.0, -7.0, 7.0, 7.0), color: (255, 235, 190, 0) ),
            ],
        ),
        // Falcon body glow.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (470.0, 70.0), quad: (10.0, 10.0), color: (255, 240, 200, 0) ),
                ( at: 1, offset: (451.1, 90.3), quad: (30.0, 30.0), color: (255, 240, 200, 255) ),
                ( at: 7, offset: (338.0, 212.0), quad: (36.0, 36.0), color: (255, 240, 200, 255) ),
                ( at: 9, offset: (338.0, 212.0), quad: (40.0, 40.0), color: (255, 240, 200, 0) ),
            ],
        ),
        // Heavy impact flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 7, offset: (319.0, 228.0), quad: (20.0, 20.0), color: (255, 225, 150, 0) ),
                ( at: 8, offset: (319.0, 228.0), quad: (200.0, 200.0), color: (255, 225, 150, 255) ),
                ( at: 18, offset: (319.0, 228.0), quad: (240.0, 240.0), color: (255, 200, 110, 0) ),
            ],
        ),
        // White-hot core.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 8, offset: (319.0, 228.0), quad: (30.0, 30.0), color: (255, 255, 255, 0) ),
                ( at: 9, offset: (319.0, 228.0), quad: (100.0, 100.0), color: (255, 255, 240, 255) ),
                ( at: 13, offset: (319.0, 228.0), quad: (120.0, 120.0), color: (255, 240, 200, 0) ),
            ],
        ),
        // First talon slash of the crossed X.
        (
            textures: ["ro://data/texture/effect/e9_counter_slash.tga"],
            blend: Add,
            keys: [
                ( at: 8, offset: (319.0, 228.0), quad: (60.0, 60.0), color: (255, 240, 200, 0), angle: 0.0 ),
                ( at: 10, offset: (319.0, 228.0), quad: (160.0, 160.0), color: (255, 240, 200, 255), angle: 0.0 ),
                ( at: 18, offset: (319.0, 228.0), quad: (176.0, 176.0), color: (255, 225, 150, 0), angle: 0.0 ),
            ],
        ),
        // Second talon slash, crossing the first.
        (
            textures: ["ro://data/texture/effect/e9_counter_slash.tga"],
            blend: Add,
            keys: [
                ( at: 10, offset: (319.0, 228.0), quad: (60.0, 60.0), color: (255, 240, 200, 0), angle: 256.0 ),
                ( at: 12, offset: (319.0, 228.0), quad: (160.0, 160.0), color: (255, 240, 200, 255), angle: 256.0 ),
                ( at: 20, offset: (319.0, 228.0), quad: (176.0, 176.0), color: (255, 225, 150, 0), angle: 256.0 ),
            ],
        ),
        // Shock ring off the impact.
        (
            textures: ["ro://data/texture/effect/ring_b.bmp"],
            blend: Add,
            keys: [
                ( at: 9, offset: (319.0, 228.0), quad: (30.0, 30.0), color: (255, 225, 150, 0) ),
                ( at: 11, offset: (319.0, 228.0), quad: (140.0, 140.0), color: (255, 225, 150, 220) ),
                ( at: 20, offset: (319.0, 228.0), quad: (260.0, 260.0), color: (255, 210, 130, 0) ),
            ],
        ),
        // Flat shock ring on the ground.
        (
            textures: ["ro://data/texture/effect/ring_b.bmp"],
            blend: Add,
            keys: [
                ( at: 9, offset: (319.0, 287.0), quad: (40.0, 12.0), color: (255, 225, 150, 0) ),
                ( at: 12, offset: (319.0, 287.0), quad: (200.0, 60.0), color: (255, 225, 150, 200) ),
                ( at: 22, offset: (319.0, 287.0), quad: (320.0, 96.0), color: (255, 210, 130, 0) ),
            ],
        ),
        // Feather burst, drifting down as it fades.
        (
            textures: ["ro://data/texture/effect/wing_paticle00.bmp"],
            blend: Blend,
            keys: [
                ( at: 9, offset: (319.0, 225.0), quad: (60.0, 37.0), color: (255, 222, 170, 0) ),
                ( at: 11, offset: (319.0, 225.0), quad: (200.0, 123.0), color: (255, 222, 170, 255) ),
                ( at: 22, offset: (319.0, 240.0), quad: (210.0, 130.0), color: (255, 218, 165, 200) ),
                ( at: 34, offset: (319.0, 262.0), quad: (220.0, 136.0), color: (255, 215, 160, 0) ),
            ],
        ),
        // Single feather falling to the left.
        (
            textures: ["ro://data/texture/effect/feather.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (300.0, 220.0), quad: (14.0, 14.0), color: (255, 245, 220, 0), angle: 0.0 ),
                ( at: 13, offset: (300.0, 220.0), quad: (22.0, 22.0), color: (255, 245, 220, 255), angle: -96.0 ),
                ( at: 22, offset: (270.0, 250.0), quad: (22.0, 22.0), color: (255, 240, 210, 220), angle: 96.0 ),
                ( at: 34, offset: (262.0, 272.0), quad: (20.0, 20.0), color: (255, 235, 200, 0), angle: 0.0 ),
            ],
        ),
        // Single feather falling to the right.
        (
            textures: ["ro://data/texture/effect/feather.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (340.0, 215.0), quad: (14.0, 14.0), color: (255, 245, 220, 0), angle: 0.0 ),
                ( at: 13, offset: (340.0, 215.0), quad: (22.0, 22.0), color: (255, 245, 220, 255), angle: -96.0 ),
                ( at: 22, offset: (372.0, 248.0), quad: (22.0, 22.0), color: (255, 240, 210, 220), angle: 96.0 ),
                ( at: 34, offset: (380.0, 270.0), quad: (20.0, 20.0), color: (255, 235, 200, 0), angle: 0.0 ),
            ],
        ),
        // Single feather falling to the center.
        (
            textures: ["ro://data/texture/effect/feather.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (325.0, 205.0), quad: (14.0, 14.0), color: (255, 245, 220, 0), angle: 0.0 ),
                ( at: 13, offset: (325.0, 205.0), quad: (22.0, 22.0), color: (255, 245, 220, 255), angle: -96.0 ),
                ( at: 22, offset: (332.0, 236.0), quad: (22.0, 22.0), color: (255, 240, 210, 220), angle: 96.0 ),
                ( at: 34, offset: (318.0, 264.0), quad: (20.0, 20.0), color: (255, 235, 200, 0), angle: 0.0 ),
            ],
