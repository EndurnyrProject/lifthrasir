// Endure (SM_ENDURE): as the reference EF_ENDURE draws it, the native endure.tga
// (忍) emblem shrinks onto the caster while light streaks slide in toward
// the body, over a short gold glow. ~0.5s.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the anchor's feet, smaller
// y is higher, 1024 angle units per turn. Soft billboard textures only: the
// ring_*/lens_* bands are cylinder wraps and read as boxes when drawn flat.
(
    fps: 30,
    layers: [
        // Gold glow.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 245.0), quad: (30.0, 30.0), color: (255, 220, 120, 0) ),
                ( at: 4, offset: (319.0, 245.0), quad: (120.0, 120.0), color: (255, 225, 130, 200) ),
                ( at: 15, offset: (319.0, 245.0), quad: (140.0, 140.0), color: (255, 200, 90, 0) ),
            ],
        ),
        // Shrinking 忍 emblem.
        (
            textures: ["ro://data/texture/effect/endure.tga"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 240.0), quad: (140.0, 140.0), color: (255, 255, 255, 0) ),
                ( at: 4, offset: (319.0, 240.0), quad: (100.0, 100.0), color: (255, 255, 255, 255) ),
                ( at: 10, offset: (319.0, 240.0), quad: (75.0, 75.0), color: (255, 255, 255, 230) ),
                ( at: 16, offset: (319.0, 240.0), quad: (45.0, 45.0), color: (255, 255, 255, 0) ),
            ],
        ),
        // Inward streak.
