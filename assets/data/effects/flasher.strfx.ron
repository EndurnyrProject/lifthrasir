// Flasher (HT_FLASHER) - authored effect.
//
// Shape: one brief white ground flash blooms at the trap, then clears before it
// reads as an explosion.
//
// The bloom is drawn SQUARE, not with the 2:1 ground squash the trap rings use.
// `lens_w.bmp` is natively 32x128 -- a portrait strip of vertical streaks -- and
// every one of the ten effects that already uses it (bash, blade_stop,
// charge_attack, double_strafe, endure, ki_impact, ki_strike, lightning_bolt,
// steel_body, call_spirits) draws it 1:1, where it reads as a radial glare.
// The 2:1 squash is for RINGS seen in perspective (grand_cross); applied to this
// texture it smears the vertical streaks into horizontal bands and stops reading
// as a flash at all.
(
    fps: 30,
    layers: [
        // A short, bright blinding bloom at the ground anchor.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 291.0), quad: (24.0, 24.0),   color: (255, 255, 255, 0) ),
                ( at: 2,  offset: (319.0, 291.0), quad: (190.0, 190.0), color: (255, 255, 255, 255) ),
                ( at: 8,  offset: (319.0, 291.0), quad: (280.0, 280.0), color: (255, 255, 255, 0) ),
            ],
        ),
    ],
)
