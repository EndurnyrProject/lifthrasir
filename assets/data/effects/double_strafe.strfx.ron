// Double Strafe (AC_DOUBLE) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive. Angles are raw STR units (1024 per turn).
//
// Shape: two retail arrow streaks (allow_b.bmp, the Arrow Shower arrow) snap
// into the torso a few frames apart, each popping a soft warm glow11 flash.
// allow_b points left at angle 0 and angles turn clockwise, so 597 aims the
// tip down-right along the flight path.
(
    fps: 30,
    layers: [
        // First arrow.
        (
            textures: ["ro://data/texture/effect/allow_b.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (212.0, 186.0), quad: (96.0, 18.0), color: (255, 240, 200, 0),   angle: 597.0 ),
                ( at: 1, offset: (238.0, 200.0), quad: (96.0, 18.0), color: (255, 245, 210, 255), angle: 597.0 ),
                ( at: 3, offset: (280.0, 222.0), quad: (96.0, 18.0), color: (255, 245, 210, 255), angle: 597.0 ),
                ( at: 5, offset: (290.0, 228.0), quad: (60.0, 16.0), color: (255, 220, 160, 0),   angle: 597.0 ),
            ],
        ),
        // Second arrow, a little lower, right behind the first.
        (
            textures: ["ro://data/texture/effect/allow_b.bmp"],
            blend: Add,
            keys: [
                ( at: 3, offset: (212.0, 196.0), quad: (96.0, 18.0), color: (255, 240, 200, 0),   angle: 597.0 ),
                ( at: 4, offset: (238.0, 210.0), quad: (96.0, 18.0), color: (255, 245, 210, 255), angle: 597.0 ),
                ( at: 6, offset: (280.0, 232.0), quad: (96.0, 18.0), color: (255, 245, 210, 255), angle: 597.0 ),
                ( at: 8, offset: (290.0, 238.0), quad: (60.0, 16.0), color: (255, 220, 160, 0),   angle: 597.0 ),
            ],
        ),
        // First impact flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 3, offset: (319.0, 238.0), quad: (16.0, 16.0), color: (255, 235, 180, 0) ),
                ( at: 4, offset: (319.0, 238.0), quad: (100.0, 100.0), color: (255, 235, 180, 255) ),
                ( at: 9, offset: (319.0, 238.0), quad: (124.0, 124.0), color: (255, 200, 120, 0) ),
            ],
        ),
        // Second impact flash.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 6,  offset: (319.0, 248.0), quad: (16.0, 16.0), color: (255, 235, 180, 0) ),
                ( at: 7,  offset: (319.0, 248.0), quad: (110.0, 110.0), color: (255, 240, 190, 255) ),
                ( at: 13, offset: (319.0, 248.0), quad: (136.0, 136.0), color: (255, 200, 120, 0) ),
            ],
        ),
    ],
)
