        // Fine yellow grains settling.
        (
            textures: ["ro://data/texture/effect/sand_y_01.bmp"],
            blend: Add,
            keys: [
                ( at: 2, offset: (319.0, 232.0), quad: (50.0, 50.0), color: (255, 225, 160, 0) ),
