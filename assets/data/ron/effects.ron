        68: ( // EFST_SPEARQUICKEN -- warm haste spear loop.
            visuals: [Str("spear_quicken_aura.strfx.ron")],
            sound: None,
            placement: Caster,
            color: (1.0, 0.9, 0.6, 0.55),
            repeating: true,
