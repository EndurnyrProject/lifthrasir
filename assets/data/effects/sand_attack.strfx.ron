// Sand Attack (TF_SPRINKLESAND): hardcoded in the official client and absent
// from the reference table (310 is unmapped there), so authored: a tan dust
// cloud hits the face while retail sand grains fan out and settle. ~0.8s.
// Independent of the server's Blind roll.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the unit's feet, smaller
// y is higher, 1024 angle units per turn. The body spans about y 191..291.
(
    fps: 30,
    layers: [
        // Tan dust cloud thrown into the face.
        (
            textures: ["ro://data/texture/effect/dust01.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (313.0, 222.0), quad: (40.0, 34.0), color: (225, 190, 125, 0) ),
                ( at: 3, offset: (319.0, 218.0), quad: (120.0, 96.0), color: (225, 190, 125, 200) ),
                ( at: 18, offset: (327.0, 226.0), quad: (175.0, 140.0), color: (200, 165, 105, 0) ),
            ],
        ),
        // Sand grain sprays fanning across the victim.
        (
            textures: ["ro://data/texture/effect/sand1.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (289.0, 228.0), quad: (30.0, 30.0), color: (255, 220, 150, 0) ),
                ( at: 2, offset: (289.0, 222.0), quad: (80.0, 80.0), color: (255, 220, 150, 255) ),
