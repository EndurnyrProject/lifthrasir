// Frost Joke (BA_FROSTJOKER) - authored effect.
//
// Convention (see bash.strfx.ron): offset & quad in STR pixels, anchor at
// (319, 291), STR_WORLD_SCALE 0.2, smaller offset.y = higher; fps 30, linear
// key lerp, Add = additive. Angles are raw STR units (1024 per turn).
//
// Shape: the joke lands and the air around the bard freezes over: a cold flash
// at the chest, then two counter-rotating sheets of the native frost_y_01.bmp
// crystals bloom outward and a frost ring races along the ground. The freeze on
// each victim is the status visual, not this cast burst.
(
    fps: 30,
    layers: [
        // Cold flash at the chest.
        (
            textures: ["ro://data/texture/effect/lens_b.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 240.0), quad: (20.0, 20.0),   color: (200, 235, 255, 0) ),
                ( at: 4,  offset: (319.0, 240.0), quad: (120.0, 120.0), color: (215, 240, 255, 230) ),
                ( at: 14, offset: (319.0, 240.0), quad: (170.0, 170.0), color: (190, 225, 255, 0) ),
            ],
        ),
        // Frost crystals blooming outward, spinning one way.
        (
            textures: ["ro://data/texture/effect/frost_y_01.bmp"],
            blend: Add,
            keys: [
                ( at: 2,  offset: (319.0, 246.0), quad: (40.0, 40.0),   color: (200, 235, 255, 0),   angle: 0.0 ),
                ( at: 8,  offset: (319.0, 246.0), quad: (150.0, 150.0), color: (215, 240, 255, 220), angle: 60.0 ),
                ( at: 20, offset: (319.0, 246.0), quad: (230.0, 230.0), color: (200, 230, 255, 140), angle: 160.0 ),
                ( at: 30, offset: (319.0, 246.0), quad: (270.0, 270.0), color: (190, 225, 255, 0),   angle: 240.0 ),
            ],
        ),
        // Second crystal sheet, spinning the other way, slightly behind.
        (
            textures: ["ro://data/texture/effect/frost_y_01.bmp"],
            blend: Add,
            keys: [
                ( at: 5,  offset: (319.0, 250.0), quad: (40.0, 40.0),   color: (200, 235, 255, 0),   angle: 512.0 ),
                ( at: 11, offset: (319.0, 250.0), quad: (150.0, 150.0), color: (215, 240, 255, 200), angle: 452.0 ),
                ( at: 23, offset: (319.0, 250.0), quad: (230.0, 230.0), color: (200, 230, 255, 120), angle: 352.0 ),
                ( at: 33, offset: (319.0, 250.0), quad: (270.0, 270.0), color: (190, 225, 255, 0),   angle: 272.0 ),
            ],
        ),
        // Frost ring racing out along the ground.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 3,  offset: (319.0, 291.0), quad: (40.0, 20.0),   color: (200, 235, 255, 0) ),
                ( at: 8,  offset: (319.0, 291.0), quad: (200.0, 100.0), color: (215, 240, 255, 210) ),
                ( at: 22, offset: (319.0, 291.0), quad: (380.0, 190.0), color: (190, 225, 255, 0) ),
            ],
        ),
    ],
)
