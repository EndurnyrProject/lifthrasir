// Frenzy (LK_BERSERK): the reference EF_REDBODY is the sound, a red body and a
// camera quake. Here a hard red flare and rising red rays on the caster; the
// catalog entry adds the shake. ~0.7s.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the anchor's feet, smaller
// y is higher, 1024 angle units per turn. Soft billboard textures only: the
// ring_*/lens_* bands are cylinder wraps and read as boxes when drawn flat.
(
    fps: 30,
    layers: [
        // Rising red rays.
        (
            textures: ["ro://data/texture/effect/light_y_01.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 280.0), quad: (80.0, 40.0), color: (255, 70, 50, 0) ),
                ( at: 3, offset: (319.0, 245.0), quad: (140.0, 130.0), color: (255, 80, 60, 255) ),
                ( at: 12, offset: (319.0, 228.0), quad: (150.0, 160.0), color: (255, 50, 40, 170) ),
                ( at: 22, offset: (319.0, 210.0), quad: (155.0, 175.0), color: (255, 30, 30, 0) ),
            ],
        ),
        // Red body flare.
        (
            textures: ["ro://data/texture/effect/glow03.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 245.0), quad: (40.0, 40.0), color: (255, 255, 255, 0) ),
                ( at: 2, offset: (319.0, 245.0), quad: (150.0, 150.0), color: (255, 200, 190, 255) ),
                ( at: 8, offset: (319.0, 245.0), quad: (155.0, 155.0), color: (255, 120, 110, 170) ),
                ( at: 20, offset: (319.0, 245.0), quad: (165.0, 165.0), color: (255, 60, 50, 0) ),
            ],
        ),
        // Burst behind the body.
        (
            textures: ["ro://data/texture/effect/pikapika.bmp"],
            blend: Add,
            keys: [
                ( at: 1, offset: (319.0, 245.0), quad: (30.0, 30.0), color: (255, 120, 90, 0) ),
                ( at: 3, offset: (319.0, 245.0), quad: (150.0, 150.0), color: (255, 140, 110, 230), angle: 40.0 ),
                ( at: 10, offset: (319.0, 245.0), quad: (180.0, 180.0), color: (255, 80, 60, 0), angle: 110.0 ),
            ],
        ),
    ],
)
