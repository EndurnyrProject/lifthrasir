// Steal (TF_STEAL, also Gank): the reference EF_STEAL (18) bursts seven
// big pok1.tga stars off the robbed unit that shrink while they fly out and
// up, fading over 0.5s. Played on success only.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the unit's feet, smaller
// y is higher, 1024 angle units per turn. The body spans about y 191..291.
(
    fps: 30,
    layers: [
        // Warm bloom where the stars burst from.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 240.0), quad: (40.0, 40.0), color: (255, 250, 215, 0) ),
                ( at: 2, offset: (319.0, 240.0), quad: (150.0, 150.0), color: (255, 250, 215, 190) ),
                ( at: 10, offset: (319.0, 240.0), quad: (180.0, 180.0), color: (255, 250, 215, 0) ),
            ],
        ),
        // Star 1 of 7 flying off the victim.
        (
