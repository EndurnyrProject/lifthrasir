// Demonstration (AM_DEMONSTRATION) -- authored effect, approximation.
//
// No reference artwork: the official client renders the Alchemist's fire field
// with a hardcoded emitter and roBrowserLegacy's `SkillEffects/SkillEffect.js`
// has no entry for AM_DEMONSTRATION (SkillUnit.js still lists its zone type
// 0xb1), so this burst and the field it leaves (`demonstration_field.strfx.ron`)
// are authored, not reference-certified.
//
// Convention (see heavens_drive.strfx.ron / fire_bolt.strfx.ron): offset & quad
// are STR pixels, the runtime maps (offset - (319, 291)) * 0.2 into world space,
// so (319, 291) sits on the anchor (here the targeted ground cell). y grows
// DOWN, so a smaller offset.y renders higher. fps 30, keys lerp linearly and
// texture_index is held (flipbook).
//
// Shape: the Fire Bottle falls as a flame streak from above, shatters on the
// cell (lens_r flash + expanding ring_red scorch), and throws burning embers
// out while a fire_smoke puff rises. The persistent burning patch is a separate
// repeating descriptor owned by the skill-unit group.
(
    fps: 30,
    layers: [
        // The bottle's flame streak falling onto the cell.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 118.0), quad: (36.0, 76.0), color: (255, 150, 60, 0),   texture_index: 0 ),
                ( at: 3,  offset: (319.0, 162.0), quad: (40.0, 84.0), color: (255, 165, 75, 215), texture_index: 1 ),
                ( at: 6,  offset: (319.0, 214.0), quad: (44.0, 92.0), color: (255, 175, 85, 235), texture_index: 2 ),
                ( at: 9,  offset: (319.0, 262.0), quad: (46.0, 96.0), color: (255, 185, 95, 245), texture_index: 3 ),
                ( at: 11, offset: (319.0, 291.0), quad: (46.0, 94.0), color: (255, 195, 105, 230), texture_index: 0 ),
                ( at: 14, offset: (319.0, 291.0), quad: (34.0, 68.0), color: (255, 175, 90, 0),   texture_index: 1 ),
            ],
        ),
        // The bottle breaking: a hot flash on the cell.
        (
            textures: ["ro://data/texture/effect/lens_r.bmp"],
            blend: Add,
            keys: [
                ( at: 10, offset: (319.0, 280.0), quad: (24.0, 24.0),   color: (255, 180, 90, 0) ),
                ( at: 13, offset: (319.0, 280.0), quad: (140.0, 140.0), color: (255, 210, 130, 235) ),
                ( at: 20, offset: (319.0, 280.0), quad: (190.0, 190.0), color: (255, 170, 80, 110) ),
                ( at: 28, offset: (319.0, 280.0), quad: (230.0, 230.0), color: (230, 130, 60, 0) ),
            ],
        ),
        // Scorched ground ring spreading across the 3x3 the field reaches.
        (
            textures: ["ro://data/texture/effect/ring_red.tga"],
            blend: Add,
            keys: [
                ( at: 11, offset: (319.0, 291.0), quad: (50.0, 25.0),   color: (255, 140, 60, 0) ),
                ( at: 15, offset: (319.0, 291.0), quad: (170.0, 85.0),  color: (255, 160, 70, 210) ),
                ( at: 24, offset: (319.0, 291.0), quad: (280.0, 140.0), color: (240, 120, 50, 130) ),
                ( at: 34, offset: (319.0, 291.0), quad: (340.0, 170.0), color: (200, 90, 40, 0) ),
            ],
        ),
        // Burning droplets thrown out of the splash.
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 12, offset: (301.0, 286.0), quad: (10.0, 10.0), color: (255, 190, 110, 0) ),
                ( at: 15, offset: (289.0, 276.0), quad: (20.0, 20.0), color: (255, 210, 140, 230) ),
                ( at: 24, offset: (272.0, 268.0), quad: (14.0, 14.0), color: (255, 170, 90, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 13, offset: (337.0, 288.0), quad: (10.0, 10.0), color: (255, 190, 110, 0) ),
                ( at: 17, offset: (352.0, 274.0), quad: (20.0, 20.0), color: (255, 210, 140, 230) ),
                ( at: 26, offset: (368.0, 264.0), quad: (14.0, 14.0), color: (255, 170, 90, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 12, offset: (319.0, 282.0), quad: (12.0, 12.0), color: (255, 195, 120, 0) ),
                ( at: 16, offset: (319.0, 258.0), quad: (22.0, 22.0), color: (255, 215, 150, 235) ),
                ( at: 27, offset: (319.0, 224.0), quad: (16.0, 16.0), color: (255, 175, 95, 0) ),
            ],
        ),
        // Smoke rising off the fresh burn.
        (
            textures: ["ro://data/texture/effect/fire_smoke.bmp"],
            blend: Blend,
            keys: [
                ( at: 14, offset: (319.0, 282.0), quad: (60.0, 44.0),   color: (90, 80, 75, 0) ),
                ( at: 20, offset: (319.0, 262.0), quad: (100.0, 74.0),  color: (100, 90, 85, 150) ),
                ( at: 28, offset: (319.0, 232.0), quad: (140.0, 104.0), color: (70, 65, 62, 110) ),
                ( at: 38, offset: (319.0, 198.0), quad: (170.0, 126.0), color: (50, 46, 44, 0) ),
            ],
        ),
    ],
)
