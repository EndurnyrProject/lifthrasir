// Potion Pitcher (AM_POTIONPITCHER) -- authored effect, approximation.
//
// No reference artwork: roBrowserLegacy's `SkillEffect.js` has no
// AM_POTIONPITCHER entry. Aesir's `am_potionpitcher.ex` throws the level's
// potion (Red, Orange, Yellow, White, Blue) at the caster, a party/guild member
// or its own Homunculus and heals through `Combat.PotionRecovery`; the
// no-damage cast reports the recipient as the effect target, so this plays on
// the recipient's body. The descriptor cannot vary with the level, so the
// artwork is the recovery bloom, not a specific potion colour.
//
// Convention: (319, 291) is the anchor (the recipient's feet), a smaller
// offset.y renders higher. fps 30, keys lerp, texture_index is held. Every
// layer is additive (retail bitmaps use a transparency colour, not alpha).
//
// Shape: the flask breaks against the recipient -- a warm recovery bloom at
// chest height, the liquid spray, a white gain ring rising off the feet and a
// few bright motes drifting up. It reads as a heal, not as an attack impact, so
// a Potion Pitcher landing on an ally is not mistaken for damage.
(
    fps: 30,
    layers: [
        // Recovery bloom at chest height.
        (
            textures: ["ro://data/texture/effect/lens_w.bmp"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 248.0), quad: (24.0, 24.0),   color: (255, 245, 215, 0) ),
                ( at: 4,  offset: (319.0, 248.0), quad: (120.0, 120.0), color: (255, 250, 225, 225) ),
                ( at: 11, offset: (319.0, 248.0), quad: (150.0, 150.0), color: (255, 240, 200, 120) ),
                ( at: 20, offset: (319.0, 248.0), quad: (180.0, 180.0), color: (250, 225, 180, 0) ),
            ],
        ),
        // The thrown liquid breaking on the recipient.
        (
            textures: [
                "ro://data/texture/effect/water_splash/water_slplash_00.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_01.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_02.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_03.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_04.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_05.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_06.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_07.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_08.bmp",
                "ro://data/texture/effect/water_splash/water_slplash_09.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 1,  offset: (319.0, 252.0), quad: (56.0, 56.0),   color: (255, 240, 200, 0),   texture_index: 0 ),
                ( at: 4,  offset: (319.0, 252.0), quad: (120.0, 120.0), color: (255, 245, 210, 210), texture_index: 2 ),
                ( at: 9,  offset: (319.0, 254.0), quad: (160.0, 160.0), color: (255, 235, 195, 150), texture_index: 5 ),
                ( at: 15, offset: (319.0, 256.0), quad: (190.0, 190.0), color: (250, 225, 180, 80),  texture_index: 8 ),
                ( at: 22, offset: (319.0, 258.0), quad: (210.0, 210.0), color: (245, 215, 170, 0),   texture_index: 9 ),
            ],
        ),
        // White gain ring rising off the feet.
        (
            textures: ["ro://data/texture/effect/ring_white.tga"],
            blend: Add,
            keys: [
                ( at: 3,  offset: (319.0, 291.0), quad: (140.0, 70.0), color: (255, 250, 225, 0) ),
                ( at: 8,  offset: (319.0, 280.0), quad: (120.0, 60.0), color: (255, 250, 230, 190) ),
                ( at: 16, offset: (319.0, 258.0), quad: (80.0, 40.0),  color: (255, 245, 215, 120) ),
                ( at: 26, offset: (319.0, 232.0), quad: (44.0, 22.0),  color: (255, 240, 205, 0) ),
            ],
        ),
        // Motes drifting up like the potion's vapour.
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 5,  offset: (301.0, 272.0), quad: (12.0, 12.0), color: (255, 245, 205, 0) ),
                ( at: 10, offset: (293.0, 252.0), quad: (22.0, 22.0), color: (255, 250, 220, 210) ),
                ( at: 20, offset: (285.0, 222.0), quad: (16.0, 16.0), color: (255, 240, 195, 0) ),
            ],
        ),
        (
            textures: ["ro://data/texture/effect/pok1.tga"],
            blend: Add,
            keys: [
                ( at: 7,  offset: (338.0, 270.0), quad: (12.0, 12.0), color: (255, 245, 205, 0) ),
                ( at: 12, offset: (348.0, 248.0), quad: (22.0, 22.0), color: (255, 250, 220, 210) ),
                ( at: 22, offset: (356.0, 218.0), quad: (16.0, 16.0), color: (255, 240, 195, 0) ),
            ],
        ),
    ],
)
