                ( at: 16, offset: (319.0, 246.0), quad: (190.0, 165.0), color: (150, 235, 120, 120), texture_index: 2 ),
                ( at: 23, offset: (319.0, 256.0), quad: (210.0, 185.0), color: (110, 200, 90, 0),    texture_index: 3 ),
            ],
        ),
        // Droplets arcing out and dripping down.
        (
