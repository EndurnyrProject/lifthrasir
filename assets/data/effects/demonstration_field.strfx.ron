// Demonstration (AM_DEMONSTRATION) burning field -- authored effect,
// approximation, one loop per server-owned cell.
//
// Aesir's `am_demonstration.ex` owns exactly one cell (the cast point) with
// `unit_range: 1`, and every enemy on the 3x3 around it takes a weapon hit each
// tick. The fire therefore reads as a patch wider than one cell, while the
// server keeps ownership of placement, the 35-60 s lifetime, the per-victim
// ticks and removal. No reference artwork exists (see
// demonstration_throw.strfx.ron).
//
// The descriptor repeats, so the loop is seamless: every layer's `at: 0` key
// equals its `at: 48` key. fps 30, 1.6 s per cycle.
(
    fps: 30,
    layers: [
        // Smouldering ground glow, breathing.
        (
            textures: ["ro://data/texture/effect/ring_red.tga"],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 291.0), quad: (150.0, 75.0), color: (255, 120, 50, 90) ),
                ( at: 24, offset: (319.0, 291.0), quad: (170.0, 85.0), color: (255, 160, 80, 130) ),
                ( at: 48, offset: (319.0, 291.0), quad: (150.0, 75.0), color: (255, 120, 50, 90) ),
            ],
        ),
        // Left flame column, flipbook fire_0001..0004.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 0,  offset: (302.0, 285.0), quad: (40.0, 72.0), color: (255, 160, 70, 165), texture_index: 0 ),
                ( at: 8,  offset: (300.0, 278.0), quad: (44.0, 80.0), color: (255, 185, 95, 195), texture_index: 1 ),
                ( at: 16, offset: (303.0, 281.0), quad: (40.0, 74.0), color: (255, 150, 65, 150), texture_index: 2 ),
                ( at: 24, offset: (301.0, 276.0), quad: (46.0, 84.0), color: (255, 190, 100, 200), texture_index: 3 ),
                ( at: 32, offset: (302.0, 283.0), quad: (42.0, 76.0), color: (255, 165, 75, 170), texture_index: 0 ),
                ( at: 40, offset: (300.0, 280.0), quad: (44.0, 80.0), color: (255, 180, 90, 185), texture_index: 1 ),
                ( at: 48, offset: (302.0, 285.0), quad: (40.0, 72.0), color: (255, 160, 70, 165), texture_index: 0 ),
            ],
        ),
        // Right flame column, half a cycle out of phase.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 0,  offset: (338.0, 279.0), quad: (44.0, 80.0), color: (255, 180, 90, 185), texture_index: 2 ),
                ( at: 8,  offset: (340.0, 284.0), quad: (40.0, 72.0), color: (255, 155, 68, 160), texture_index: 3 ),
                ( at: 16, offset: (337.0, 277.0), quad: (46.0, 84.0), color: (255, 190, 100, 200), texture_index: 0 ),
                ( at: 24, offset: (339.0, 282.0), quad: (42.0, 76.0), color: (255, 165, 75, 170), texture_index: 1 ),
                ( at: 32, offset: (338.0, 279.0), quad: (44.0, 80.0), color: (255, 180, 90, 185), texture_index: 2 ),
                ( at: 40, offset: (340.0, 283.0), quad: (40.0, 74.0), color: (255, 160, 70, 165), texture_index: 3 ),
                ( at: 48, offset: (338.0, 279.0), quad: (44.0, 80.0), color: (255, 180, 90, 185), texture_index: 2 ),
            ],
        ),
        // Centre flame, shorter, filling the cell itself.
        (
            textures: [
                "ro://data/texture/effect/fire_0001.bmp",
                "ro://data/texture/effect/fire_0002.bmp",
                "ro://data/texture/effect/fire_0003.bmp",
                "ro://data/texture/effect/fire_0004.bmp",
            ],
            blend: Add,
            keys: [
                ( at: 0,  offset: (319.0, 284.0), quad: (36.0, 62.0), color: (255, 175, 90, 155), texture_index: 1 ),
                ( at: 6,  offset: (320.0, 278.0), quad: (40.0, 70.0), color: (255, 195, 110, 185), texture_index: 2 ),
                ( at: 14, offset: (318.0, 286.0), quad: (34.0, 58.0), color: (255, 165, 80, 140), texture_index: 3 ),
                ( at: 22, offset: (319.0, 280.0), quad: (38.0, 66.0), color: (255, 185, 100, 175), texture_index: 0 ),
                ( at: 30, offset: (320.0, 285.0), quad: (36.0, 60.0), color: (255, 170, 85, 150), texture_index: 1 ),
                ( at: 38, offset: (319.0, 277.0), quad: (40.0, 70.0), color: (255, 195, 110, 185), texture_index: 2 ),
                ( at: 48, offset: (319.0, 284.0), quad: (36.0, 62.0), color: (255, 175, 90, 155), texture_index: 1 ),
            ],
        ),
        // Smoke drifting up, fading in and out inside the same cycle.
        (
            textures: ["ro://data/texture/effect/fire_smoke.bmp"],
            blend: Blend,
            keys: [
                ( at: 0,  offset: (319.0, 288.0), quad: (70.0, 52.0),  color: (70, 64, 60, 0) ),
                ( at: 16, offset: (319.0, 258.0), quad: (100.0, 74.0), color: (80, 72, 68, 95) ),
                ( at: 32, offset: (319.0, 226.0), quad: (130.0, 96.0), color: (60, 55, 52, 60) ),
                ( at: 48, offset: (319.0, 288.0), quad: (70.0, 52.0),  color: (70, 64, 60, 0) ),
            ],
        ),
    ],
)
