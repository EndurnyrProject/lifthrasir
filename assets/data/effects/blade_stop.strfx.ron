// Root / Blade Stop (MO_BLADESTOP) ready stance - no reference artwork. A sharp
// cool flash at the guard, a large cross glint clamping shut on it and a
// catch glint: a controlled seize rather than a burst. ~0.35s. The paired hold
// status (EFST 85/1114) is an opt3 tint, not this cast.
// Coordinates follow inc_agi.strfx.ron: (319, 291) is the unit's feet, smaller
// y is higher, 1024 angle units per turn. The body spans about y 191..291.
(
    fps: 30,
    layers: [
        // Sharp focus flash at the guard.
        (
            textures: ["ro://data/texture/effect/glow11.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 224.0), quad: (14.0, 14.0), color: (235, 242, 255, 0) ),
                ( at: 2, offset: (319.0, 224.0), quad: (120.0, 120.0), color: (235, 242, 255, 230) ),
                ( at: 9, offset: (319.0, 224.0), quad: (150.0, 150.0), color: (235, 242, 255, 0) ),
            ],
        ),
        // Large cross glint clamping shut on the guard: the seize.
        (
            textures: ["ro://data/texture/effect/superstar1.bmp"],
            blend: Add,
            keys: [
                ( at: 0, offset: (319.0, 224.0), quad: (220.0, 220.0), color: (235, 242, 255, 0) ),
                ( at: 2, offset: (319.0, 224.0), quad: (160.0, 160.0), color: (235, 242, 255, 255) ),
                ( at: 8, offset: (319.0, 224.0), quad: (50.0, 50.0), color: (235, 242, 255, 0) ),
            ],
        ),
        // Catch glint as it closes.
        (
            textures: ["ro://data/texture/effect/superstar1.bmp"],
            blend: Add,
            keys: [
                ( at: 7, offset: (319.0, 224.0), quad: (17.5, 17.5), color: (245, 248, 255, 0) ),
                ( at: 9, offset: (319.0, 224.0), quad: (70.0, 70.0), color: (245, 248, 255, 255) ),
                ( at: 13, offset: (319.0, 224.0), quad: (21.0, 21.0), color: (245, 248, 255, 0) ),
            ],
        ),
    ],
)
